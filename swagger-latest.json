              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Items per page (1-100).",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "ETag": {
                "description": "Entity or aggregate ETag",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Cache directives",
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "description": "Total items for current filter",
                "schema": {
                  "type": "string"
                }
              },
              "X-Page": {
                "description": "Current page",
                "schema": {
                  "type": "string"
                }
              },
              "X-Page-Size": {
                "description": "Page size",
                "schema": {
                  "type": "string"
                }
