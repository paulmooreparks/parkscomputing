    "/api/auth/token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Issue a JWT access token in exchange for credentials (placeholder static credential check).",
        "description": "Supports application/json, application/xfer, or application/x-www-form-urlencoded.\r\nExample JSON: { \"username\":\"admin\", \"password\":\"change-me\" }\r\nExample Xfer: {\\n  username \"admin\"\\n  password \"change-me\"\\n}\r\nExample form fields: username=admin&password=change-me\r\nSuccessful token (truncated): { \"accessToken\":\"eyJhbGciOi...\",\"tokenType\":\"Bearer\",\"expiresInSeconds\":28800 }",
        "requestBody": {
          "content": {
            "application/xfer": {
              "schema": {
                "type": "string",
                "description": "XferLang representation",
                "example": "Microsoft.OpenApi.Any.OpenApiString"
              },
              "example": "Microsoft.OpenApi.Any.OpenApiString",
              "examples": {
                "xfer": {
                  "summary": "XferLang",
                  "description": "XferLang media representation",
                  "value": "{\r\n  username \"SampleName\"\r\n  password \"string\"\r\n}"
                }
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token issued",
            "headers": {
              "ETag": {
                "description": "Entity or aggregate ETag",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Cache directives",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/xfer": {
                "schema": {
                  "type": "string",
                  "description": "XferLang representation",
                  "example": "Microsoft.OpenApi.Any.OpenApiString"
                },
                "example": "Microsoft.OpenApi.Any.OpenApiString",
                "examples": {
                  "xfer": {
                    "summary": "XferLang",
                    "description": "XferLang media representation",
                    "value": "{\r\n  accessToken \"string\"\r\n  tokenType \"string\"\r\n  expiresInSeconds 42\r\n}"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation / malformed body",
            "content": {
              "application/xfer": {
                "schema": {
                  "type": "string",
                  "description": "XferLang representation",
                  "example": "Microsoft.OpenApi.Any.OpenApiString"
                },
                "example": "Microsoft.OpenApi.Any.OpenApiString"
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
