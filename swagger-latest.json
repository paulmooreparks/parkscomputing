              "X-RateLimit-Limit": {
                "description": "Request limit per window (illustrative)",
                "schema": {
                  "type": "string"
                }
              },
              "X-RateLimit-Remaining": {
                "description": "Remaining requests in window",
                "schema": {
                  "type": "string"
                }
              },
              "X-RateLimit-Reset": {
                "description": "Epoch seconds window resets",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/xfer": {
                "schema": {
                  "type": "string",
                  "description": "XferLang representation",
                  "example": "Microsoft.OpenApi.Any.OpenApiString"
                },
                "example": "Microsoft.OpenApi.Any.OpenApiString",
                "examples": {
                  "xfer": {
                    "summary": "XferLang",
                    "description": "XferLang media representation",
                    "value": "(\r\n  {\r\n    id \"sample-slug\"\r\n    slug \"string\"\r\n    title \"string\"\r\n    description <\"Sample description\">\r\n    createdUtc \"string\"\r\n    updatedUtc \"string\"\r\n    language \"string\"\r\n    rawMarkdown \"string\"\r\n    rawHtml \"string\"\r\n    published ~true \r\n    links (\r\n      {\r\n        rel \"string\"\r\n        method \"string\"\r\n        href \"string\"\r\n      }\r\n    )\r\n  }\r\n)"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ContentResource"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests"
