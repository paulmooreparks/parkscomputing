<! document { xferlang "0.15" } !>
{
    slug "home"
    title "Home"
    url "/home"
    description "Parks Computing Site Home"
    menu [
        {
            menu-id "site"
            title "Parks Computing"
            icon "/favicon-32x32.png"
            nav [
                { title "Home" url "/" }
                { slug "about" title "About Parks Computing" }
                { slug "settings" title "Site settings" url "/page/settings" }
            ]
        }
        {
            menu-id "go"
            title "Go"
            nav [
                { title "Find in the list" command "find" when "window" }
                { slug "resume-of-paul-m-parks" title "Resume of Paul M. Parks" }
                { separator ~true when "classic" }
                { title "All" url "/home" when "classic" }
                { from "sections" when "classic" }
            ]
        }
        {
            menu-id "applets"
            title "Applets"
            nav [ { from "applets" } ]
        }
        {
            menu-id "view"
            title "View"
            nav [
                { title "Windowed view" command "view" args { value "window" } }
                { title "Classic view" command "view" args { value "classic" } }
                { title "Show sidebar" command "sidebar" when "window" }
                { separator ~true }
                { title "Theme" nav [
                    { title "Light" command "theme" args { value "light" } }
                    { title "Dark" command "theme" args { value "dark" } }
                    { title "Follow the system" command "theme" args { value "system" } }
                ] }
            ]
        }
        {
            menu-id "window"
            title "Window"
            when "window"
            window-commands ~true
            nav [ ]
        }
        {
            menu-id "help"
            title "Help"
            nav [
                { title "Site help and keyboard navigation" url "/page/site-help" }
                { slug "terminal-guide" title "Terminal Guide" url "/page/terminal-guide" }
            ]
        }
    ]
    nav [
        {
            slug "applications"
            title "Applications"
            description "Here are some client-based applications I've written."
            nav [
                { slug "pbrain" }
                { slug "windragsens" }
                { slug "dragsens" }
            ]
        }
        {
            slug "applets"
            title "Applets"
            description "Here are some web-based applications written in PUDL."
            nav [
                {
                    slug "settings"
                    title "Settings"
                    description "Theme, default view, window preferences, and this browser's data"
                    tags [ "web apps" "site development" ]
                }
                {
                    slug "theme-studio"
                    win "0.9,0.9"
                    title "PUDL Theme Studio"
                    description "Make a PUDL theme: edit its colours, watch PUDL's components take them, check their contrast, and take the CSS"
                    tags [ "web apps" "site development" ]
                }
                {
                    slug "barcode-scanner"
                    title "Barcode Scanner"
                    description "Scan camera images and decode retail layouts"
                    tags [ "web apps" "barcodes" "retail" ]
                }
                {
                    slug "barcodes"
                    title "Barcode Tool"
                    description "Make retail barcodes with embedded data, and read them back"
                    tags [ "web apps" "barcodes" ]
                }
                {
                    slug "terminal"
                    win "0.5,0.7"
                    min "420,220"
                    title "Terminal"
                    description "This site in terminal mode: browse with ls and cd, read with cat, launch the applets"
                    tags [ "web apps" "site development" ]
                }
                {
                    slug "files"
                    win "0.6,0.75"
                    title "Files"
                    description "The site and your own files as folders: browse the pages, launch the applets, keep files of your own"
                    tags [ "web apps" "site development" ]
                }
                {
                    slug "editor"
                    win "0.6,0.8"
                    title "Editor"
                    description "A text editor for your own files, with syntax colouring, search and replace, and tabs"
                    tags [ "web apps" "site development" ]
                }
                {
                    slug "diff"
                    win "0.85,0.85"
                    title "Diff Viewer"
                    description "Compare two texts line by line, side by side or in one column, from the site's files, your computer, or pasted in"
                    tags [ "web apps" "site development" ]
                }
                {
                    slug "dice"
                    title "Dice"
                    description "Roll up to three dice"
                    tags [ "web apps" "games" ]
                }
                {
                    slug "sudoku"
                    win "0.28,0.88"
                    title "Sudoku"
                    description "A Sudoku game that lets you edit and share games"
                    tags [ "web apps" "games" ]
                }
                {
                    slug "conway"
                    win "0.22,0.6"
                    title "Conway's Game of Life"
                    description "The game alone; the article about it is under Articles"
                    tags [ "web apps" "games" "algorithms" ]
                }
                {
                    slug "flashcards"
                    win "0.54,0.66"
                    title "Barcode Flash Cards"
                    description "The drill alone; the article about it is under Articles"
                    tags [ "web apps" "barcodes" "learning" ]
                }
            ]
        }
        {
            slug "projects"
            title "Projects"
            description "Some personal projects"
            nav [
                {
                    slug "xferlang.org"
                    title "XferLang"
                    url "https://xferlang.org/"
                    description "The Official XferLang Site"
                    frame ~true
                }
                {
                    slug "a2c"
                    title "Api2Cli"
                    url "https://github.com/paulmooreparks/Api2Cli"
                    description "A command-line tool for working with web APIs"
                }
                {
                    slug "cliffer"
                    title "Cliffer"
                    url "https://github.com/paulmooreparks/Cliffer"
                    description "A .NET library to make it easier to write CLI applications"
                }
                {
                    slug "cliffer-basic"
                    title "Cliffer Basic"
                    url "https://github.com/paulmooreparks/ClifferBasic"
                    description "An old-school Basic interpreter written with Cliffer"
                }
                {
                    slug "site-engine"
                    title "Site Engine"
                    url "https://github.com/paulmooreparks/parkscomputing"
                    description "The code for this site"
                }
            ]
        }
        {
            slug "links"
            title "Links"
            description "Links to other sites"
            nav [
                {
                    slug "padmajairam.com"
                    title "Padma Jairam -- Counselling Psychologist"
                    url "https://padmajairam.com/"
                    description "My wife's counselling psychology practice"
                    frame ~true
                }
                {
                    slug "github"
                    title "GitHub"
                    url "https://github.com/paulmooreparks/"
                    description "My GitHub repositories"
                }
                {
                    slug "linkedin"
                    title "LinkedIn"
                    url "https://www.linkedin.com/in/paulmooreparks/"
                    description "My LinkedIn profile"
                }
            ]
        }
        {
            slug "resume-of-paul-m-parks"
            title "My Résumé"
        }
    ]
    posts [
        </ { slug "xferlang-site-navigation" } />
        </ { slug "my-llm-experience" tags ["programming"] } />
        { slug "parks-laws-of-debugging" tags ["programming"] }
        {
            slug "sudoku"
            win "0.17,0.58"
            tags ["games" "programming"]
            excerpt <"I didn't like most of the Sudoku apps I found, so I decided to write one as a fun little evening and weekend project. It lets you edit and share games.">
        }
        {
            slug "resume-of-paul-m-parks"
            description "Updated Résumé"
            excerpt <"Fitting almost 35 years of professional experience into a four-page Microsoft Word document is a daunting task!">
        }
        { slug "excel-employee-capacity-spreadsheet" }
        { slug "personas-in-the-wild" }
        {
            slug "becoming-a-developer-overnight-in-only-five-years"
            excerpt <"This post was inspired by an article on Cal Newport's site that caused me to reflect on my path to my current career.">
        }
        { slug "new-website-design" }
        { slug "fizzbuzz" tags ["programming"] }
        { slug "set-associative-cache-in-c-part-2-interface-design" tags ["programming" "csharp"] }
        { slug "set-associative-cache-in-c-part-1-analysis-initial-design" tags ["programming" "csharp"] }
        { slug "barbecue-and-project-management" tags ["project-management"] }
        { slug "scheduling-every-minute-revisited" tags ["productivity"] }
        { slug "conways-game-of-life" tags ["games" "programming"] }
        { slug "how-i-plan-my-day" tags ["productivity"] }
        { slug "pbrain" }
        { slug "windragsens" }
        { slug "master-foo-and-the-technical-recruiter" }
        { slug "dragsens" }
        { slug "george-orwell-and-effective-coding" }
        { slug "compute-magazine-archives" }
        { slug "barcode-generator" }
    ]
}
