{
  "id": "parks.barcode",
  "version": "1.0.0",
  "apiVersion": 1,
  "title": "Barcode Tool",
  "description": "Generate and interpret retail, logistics and general barcode values.",
  "module": "barcode.js",
  "actions": [
    {
      "ref": "parks.barcode/generate@1",
      "title": "Generate Barcode",
      "description": "Generate a barcode SVG from text using any supported symbology. Preserve identifiers as strings, including leading zeros. This creates an artifact without writing a user-selected file.",
      "inputSchema": {
        "type": "object", "additionalProperties": false, "required": ["symbology", "data"],
        "properties": {
          "symbology": { "type": "string", "enum": ["ean13", "ean8", "upca", "upce", "gs1-128", "itf14", "itf", "code128", "code39", "codabar", "qr"] },
          "data": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "moduleMM": { "type": "number", "minimum": 0.1, "maximum": 2, "default": 0.33 },
          "showText": { "type": "boolean", "default": true },
          "options": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "check": { "type": "boolean" }, "bearer": { "type": "boolean" },
              "start": { "enum": ["A", "B", "C", "D"] }, "stop": { "enum": ["A", "B", "C", "D"] },
              "ecc": { "enum": ["L", "M", "Q", "H"] }
            }
          },
          "highlights": {
            "type": "object", "additionalProperties": false,
            "properties": { "checks": { "type": "boolean" }, "structure": { "type": "boolean" } }
          },
          "render": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "showText": { "type": "boolean" },
              "hri": { "type": ["string", "null"], "maxLength": 8192 },
              "charColors": { "type": "array", "maxItems": 8192, "items": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" } },
              "bands": {
                "type": "array", "maxItems": 8192,
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["x0", "x1", "color"],
                  "properties": {
                    "x0": { "type": "number", "minimum": 0, "maximum": 1000000 }, "x1": { "type": "number", "minimum": 0, "maximum": 1000000 },
                    "y0": { "type": "number", "minimum": 0, "maximum": 1000000 }, "y1": { "type": "number", "minimum": 0, "maximum": 1000000 },
                    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
                  }
                }
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object", "additionalProperties": false, "required": ["symbology", "data", "widthMM", "heightMM", "image"],
        "properties": {
          "symbology": { "type": "string" },
          "data": { "type": "string" },
          "widthMM": { "type": "number", "exclusiveMinimum": 0 },
          "heightMM": { "type": "number", "exclusiveMinimum": 0 },
          "image": { "$ref": "#/$defs/artifact" }
        },
        "$defs": {
          "artifact": {
            "type": "object", "additionalProperties": false, "required": ["id", "invocationId", "name", "mime", "size"],
            "properties": {
              "id": { "type": "string" }, "invocationId": { "type": "string" }, "name": { "type": "string" }, "mime": { "type": "string" },
              "size": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      },
      "capabilities": ["artifact.create"],
      "replay": "pure"
    },
    {
      "ref": "parks.barcode/interpret@1",
      "title": "Interpret Barcode",
      "description": "Interpret a scanned or pasted barcode value and explain possible formats and check digits. This does not scan images or use a camera.",
      "inputSchema": {
        "type": "object", "additionalProperties": false, "required": ["data"],
        "properties": { "data": { "type": "string", "minLength": 1, "maxLength": 4096 } }
      },
      "outputSchema": {
        "type": "object", "additionalProperties": false, "required": ["matches"],
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "type": "object", "required": ["symbology", "title", "valid"],
              "properties": { "symbology": { "type": "string" }, "title": { "type": "string" }, "valid": { "type": "boolean" }, "note": { "type": "string" } }
            }
          }
        }
      },
      "capabilities": [],
      "replay": "pure"
    }
  ]
}
