{
  "id": "parks.dice",
  "version": "1.0.0",
  "apiVersion": 1,
  "title": "Dice",
  "description": "Roll dice.",
  "module": "dice.js",
  "actions": [
    {
      "ref": "parks.dice/roll@1",
      "title": "Roll Dice",
      "description": "Roll one or more fair dice and give each value and the total. Each roll is independent and uses the browser's cryptographic random numbers.",
      "inputSchema": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "dice": { "type": "integer", "minimum": 1, "maximum": 100, "default": 2, "description": "How many dice to roll." },
          "sides": { "type": "integer", "minimum": 2, "maximum": 1000, "default": 6, "description": "How many sides each die has." }
        }
      },
      "outputSchema": {
        "type": "object", "additionalProperties": false, "required": ["values", "total"],
        "properties": {
          "values": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "total": { "type": "integer", "minimum": 1 }
        }
      },
      "capabilities": [],
      "replay": "pure"
    }
  ]
}
