@model ParksComputing.Engine.Pages.Models.NavContentModel
@* A <nav-content> element's links in a row, in PUDL's terms (0.74.0): a
   page is a link, and a page with pages under it is a split button whose
   main key opens it and whose caret opens a menu of the pages under it.
   With descriptions on, each link's description is its tooltip. *@
@{
    var navNode = Model.NavNode;
    var containerClass = Model.GetContainerCssClass();
    string? Tip(ParksComputing.Engine.Pages.Services.NavNode? n) =>
        Model.ShowDescriptions && n is not null && (n.Description ?? n.Excerpt ?? n.Title) is { Length: > 0 } t ? t : null;
}

@if (navNode != null)
{
    <ul class="@containerClass">
        @if (Model.ShowRoot)
        {
            <li><a class="btn btn-sm" href="@navNode.Url" title="@Tip(navNode)">@navNode.Title</a></li>
        }

        @if (navNode.Nav != null && Model.MaxDepth > 0)
        {
            foreach (var link in navNode.Nav)
            {
                if (link is null) { continue; }
                if (link.Nav != null && link.Nav.Length > 0 && Model.MaxDepth > 1)
                {
                    var menuId = "nav-" + Guid.NewGuid().ToString("N")[..12];
                    <li>
                        <span class="split-btn">
                            <a class="btn btn-sm" href="@link.Url" title="@Tip(link)">@link.Title</a>
                            <span class="menu">
                                <button class="btn btn-sm menu-btn" type="button" popovertarget="@menuId" aria-label="Pages under @link.Title"></button>
                                <nav class="menu-panel" id="@menuId" popover aria-label="@link.Title">
                                    @foreach (var sublink in link.Nav)
                                    {
                                        if (sublink is null) { continue; }
                                        <a class="menu-action" href="@sublink.Url" title="@Tip(sublink)" target="@(string.IsNullOrEmpty(sublink.Target) ? null : sublink.Target)">@sublink.Title</a>
                                    }
                                </nav>
                            </span>
                        </span>
                    </li>
                }
                else
                {
                    <li><a class="btn btn-sm" href="@link.Url" title="@Tip(link)">@link.Title</a></li>
                }
            }
        }
    </ul>
}
