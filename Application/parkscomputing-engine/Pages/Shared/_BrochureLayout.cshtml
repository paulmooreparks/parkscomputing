@using System
@using System.Linq
@using ParksComputing.Engine.Pages.Services
@inject StaticFileReaderService FileReaderService
@inject INavService Nav
@inject MarkdownPages MarkdownExport
@inject Microsoft.Extensions.Options.IOptions<SiteOptions> SiteConfig
@inject Microsoft.Extensions.Options.IOptions<ParksComputing.Engine.Identity.AccountOptions> AccountsConfig
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@* A brochure site's layout (Pages/Services/SiteOptions.cs), which
   BrochureLayoutExpander gives every page that asks for _Layout: the
   classic view only, with no window view, applets, menus of commands or
   account chrome. Nothing in it belongs to one site. The site's own content
   supplies the rest:

   - content/head-section.html: fonts, analytics and the site's stylesheet;
   - content/header-section.html: the name, logo and contact links;
   - sitenav.xfer: the main navigation, one link for each top-level entry
     that has a title, and the Recent list from the first feed section;
   - content/footer-section.html: the footer.

   The page is a header, a bar of links to the site's places, the page
   itself on a raised panel with the Recent list beside it on a wide screen
   (below it on a narrow one), and the footer. It moves nothing on its own
   and needs no script. *@
@{
    var root = Nav.GetRoot();
    var path = Context.Request.Path.Value ?? "/";
    string Norm(string? p) => (p ?? "").TrimEnd('/').ToLowerInvariant();
    var current = Norm(path == "/home" ? "/" : path);
    var places = (root.Nav ?? Array.Empty<NavNode>())
        .Where(n => !string.IsNullOrWhiteSpace(n.Title) && !string.IsNullOrWhiteSpace(n.Url))
        .ToList();
    var feed = NavService.Sections(root).FirstOrDefault(s => s.Feed);
    // The editing pages (Pages/SiteAdmin) take the whole width.
    bool workspace = ViewData["Workspace"] as bool? ?? false;
    var recent = feed is null || workspace ? new List<NavNode>()
        : feed.Nav!.OrderByDescending(n => NavService.EffectiveDate(n) ?? DateTime.MinValue).Take(5).ToList();
    // The section a page belongs to is marked as the reader's place too, so
    // an article marks Thoughts.
    bool Here(NavNode n) =>
        Norm(n.Url) == current || (n.Nav?.Any(c => Norm(c.Url) == current) ?? false);
}
<!DOCTYPE html>
<html lang="@(ViewData["Lang"] as string ?? "en")" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    @{
        // The page's own title, then the site's (sitenav.xfer's root
        // title), as a browser tab or a search result shows it.
        var pageTitle = ViewData["Title"]?.ToString() ?? "";
        var siteTitle = root.Title ?? "";
        var tabTitle = string.IsNullOrWhiteSpace(siteTitle) || pageTitle.Contains(siteTitle, StringComparison.OrdinalIgnoreCase)
            ? pageTitle : string.IsNullOrWhiteSpace(pageTitle) ? siteTitle : pageTitle + " - " + siteTitle;
    }
    <title>@Html.Raw(tabTitle)</title>
    <link rel="stylesheet" href="~/pudl/pudl.css" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    @{
        // The page as machines read it (Pages/Services/MarkdownPages.cs):
        // its one address, its description, how a shared link to it looks,
        // and its Markdown for AI readers.
        var mdSlug = ViewData["PageId"] as string ?? (path == "/home" ? "index" : null);
        var mdPage = mdSlug is null ? null : MarkdownExport.Load(mdSlug);
        var origin = MarkdownExport.OriginOr($"{Context.Request.Scheme}://{Context.Request.Host}");
        bool isArticle = mdSlug is not null && NavService.Articles(root).Any(n => string.Equals(n.Slug, mdSlug, StringComparison.OrdinalIgnoreCase));
    }
    @if (mdPage is not null)
    {
        var pageUrl = origin + MarkdownExport.PageUrlOf(mdPage.Slug);
        var image = mdPage.Image is null ? null : mdPage.Image.StartsWith("/") ? origin + mdPage.Image : mdPage.Image;
        <link rel="canonical" href="@pageUrl" />
        @* A page that gives no description of its own already has one from
           its opening words (Pages/page.cshtml.cs). *@
        <meta property="og:site_name" content="@siteTitle" />
        <meta property="og:type" content="@(isArticle ? "article" : "website")" />
        <meta property="og:title" content="@mdPage.Title" />
        <meta property="og:description" content="@mdPage.Summary" />
        <meta property="og:url" content="@pageUrl" />
        @if (image is not null)
        {
            <meta property="og:image" content="@image" />
        }
        <meta name="twitter:card" content="@(image is null ? "summary" : "summary_large_image")" />
        @if (isArticle)
        {
            @* An article's structured data (schema.org), from its own file. *@
            var article = new Dictionary<string, object?> {
                ["@context"] = "https://schema.org",
                ["@type"] = "BlogPosting",
                ["headline"] = mdPage.Title,
                ["description"] = mdPage.Summary,
                ["url"] = pageUrl,
                ["mainEntityOfPage"] = pageUrl,
                ["datePublished"] = mdPage.Date?.ToString("yyyy-MM-dd"),
                ["dateModified"] = mdPage.Modified.ToString("yyyy-MM-dd"),
                ["author"] = new Dictionary<string, object?> { ["@type"] = "Person", ["name"] = SiteConfig.Value.Author ?? siteTitle, ["url"] = origin + "/" },
                ["image"] = image
            };
            var articleJson = System.Text.Json.JsonSerializer.Serialize(article.Where(kv => kv.Value is not null).ToDictionary(kv => kv.Key, kv => kv.Value),
                new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }).Replace("</", "<\\/");
            @* Written whole: Razor would encode the + in the type. *@
            @Html.Raw("<script type=\"application/ld+json\">" + articleJson + "</script>")
        }
        <link rel="alternate" type="text/markdown" href="@MarkdownExport.MarkdownUrlOf(mdPage.Slug)" title="This page as Markdown" />
    }
    <link rel="alternate" type="text/plain" href="/llms.txt" title="This site for AI readers" />
    @if (AccountsConfig.Value.Enabled && (workspace || User.Identity?.IsAuthenticated == true
        || path.StartsWith("/account", StringComparison.OrdinalIgnoreCase)))
    {
        @* Signing in, passkeys and the account page (js/accounts.js and
           css/account.css, copied into the site as PUDL is). The token lets
           a script's request pass the antiforgery check. Only the account
           and editing pages, and someone signed in, get them: the token
           sets a cookie, and a reader of the public pages gets none. The
           staff go to /admin. *@
        <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
        <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
        <script src="~/js/accounts.js" defer asp-append-version="true"></script>
    }
    @RenderSection("Meta", required: false)
    @RenderSection("Links", required: false)
    @RenderSection("Style", required: false)
    @RenderSection("HeadScripts", required: false)
    @Html.RenderStaticFile("/content/head-section.html", FileReaderService)
</head>
<body class="brochure">
    <a class="skip-link" href="#main">Skip to the page</a>
    <header class="brochure-header">
        <div class="brochure-inner">
            @Html.RenderStaticFile("/content/header-section.html", FileReaderService)
        </div>
    </header>
    @if (places.Count > 0)
    {
        <nav class="brochure-nav" aria-label="Main">
            <ul class="brochure-inner">
                @foreach (var p in places)
                {
                    <li><a href="@p.Url" aria-current="@(Here(p) ? "page" : null)">@p.Title</a></li>
                }
            </ul>
        </nav>
    }
    <div class="brochure-inner brochure-body@(recent.Count > 0 ? " has-aside" : "")">
        @* data-page is the page's slug, so a site's stylesheet can give one
           page, such as a CV, a look of its own. *@
        <main id="main" class="brochure-page" tabindex="-1" data-page="@(ViewData["PageId"] as string ?? (path == "/home" ? "home" : null))">
            @RenderBody()
        </main>
        @if (recent.Count > 0)
        {
            <aside class="brochure-aside" aria-labelledby="recent-title">
                <h2 class="brochure-aside-title" id="recent-title">Recent @feed!.Title</h2>
                <ul class="md-list">
                    @foreach (var r in recent)
                    {
                        var date = NavService.EffectiveDate(r);
                        <li>
                            <a class="md-item" href="@r.Url" aria-current="@(Norm(r.Url) == current ? "page" : null)">
                                @Html.Raw(r.Title)
                                @if (date is not null)
                                {
                                    <span class="md-meta"><time datetime="@date.Value.ToString("yyyy-MM-dd")">@date.Value.ToString("d MMMM yyyy")</time></span>
                                }
                            </a>
                        </li>
                    }
                </ul>
            </aside>
        }
    </div>
    <footer class="brochure-footer">
        <div class="brochure-inner">
            @Html.RenderStaticFile("/content/footer-section.html", FileReaderService)
        </div>
    </footer>
</body>
</html>
