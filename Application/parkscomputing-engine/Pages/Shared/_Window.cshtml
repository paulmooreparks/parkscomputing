@model ParksComputing.Engine.Pages.Models.WindowViewModel
@inject ParksComputing.Engine.Pages.Services.INavService TagNav
@inject Microsoft.Extensions.Options.IOptions<ParksComputing.Engine.Identity.AdminOptions> AdminConfig
@{
    // The button hrefs are placeholders here; pudl-windows.js rewrites each
    // one to the URL of the state it produces. Without script the window is
    // only ever present because the server rendered it from the URL, and the
    // page button still leads to the article's own page.
    string style = Model.X.HasValue
        ? $"--win-x:{Model.X:0.###}; --win-y:{Model.Y:0.###}; --win-w:{Model.W:0.###}; --win-h:{Model.H:0.###}"
        : string.Empty;
}
@* Razor renders data-* attributes even for null values, so the parent
   attribute is emitted only for a child window. *@
@* A section, not an article: ARIA allows role="dialog" on a section
   (PUDL 0.23.0). *@
<section class="win @(Model.Active ? "active" : string.Empty)" data-win="@Model.Key"
         @(Model.Parent is null ? null : Html.Raw($"data-win-parent=\"{Model.Parent}\""))
         data-win-mode="@(Model.Mode ?? "floating")"
         @(Model.SizeMode is null ? null : Html.Raw($"data-win-size=\"{Model.SizeMode}\""))
         @(Model.MinSize is null ? null : Html.Raw($"data-win-min=\"{Model.MinSize}\""))
         @(Model.MaxSize is null ? null : Html.Raw($"data-win-max=\"{Model.MaxSize}\""))
         role="dialog" aria-labelledby="win-@Model.Key-title"
         style="@style" @(Model.Minimized ? Html.Raw("hidden") : null)>
    <header class="win-head">
        @* PUDL's window menu (0.32.0), at the left of the title bar: the
           window's own commands and snap zones, then the applet's, then
           Close. PUDL builds the menu itself each time it opens. *@
        <button type="button" class="win-btn" data-win-action="menu" aria-label="Window menu" title="Window menu"></button>
        <h2 class="win-title" id="win-@Model.Key-title">@Model.Title</h2>
        <nav class="win-chrome" aria-label="Window">
            @if (Model.Parent is null)
            {
                if (!string.IsNullOrEmpty(Model.PageUrl))
                {
                    @* An external destination's page opens in a new tab, so
                       the desktop is not navigated away. *@
                    <a class="win-btn" data-win-action="page" href="@Model.PageUrl"
                       target="@(Model.FrameUrl is null ? null : "_blank")" rel="@(Model.FrameUrl is null ? null : "noopener")"
                       aria-label="Open as a page" title="Open as a page"></a>
                }
                <a class="win-btn" data-win-action="minimize" href="?" aria-label="Minimize" title="Minimize"></a>
            }
            @* A child keeps maximize and restore (it floats when its opener
               did) but never minimize, since it has no dock tab. *@
            <a class="win-btn" data-win-action="maximize" href="?" aria-label="Maximize" title="Maximize"></a>
            <a class="win-btn" data-win-action="close" href="?" aria-label="Close" title="Close"></a>
        </nav>
    </header>
    <div class="win-body">
        @if (Model.FrameUrl is null && Model.Parent is null && Model.Tags.Length > 0)
        {
            @* The tag row: each tag opens a menu of the articles under it,
               and choosing one opens that article's window. A list is a
               choice to make, not a place to keep, so it gets no window of
               its own. The menu is a popover, so it works without script.
               It belongs to the window, not the page, so an article framed
               for its own scripts gets it too, above the frame, and the
               framed page leaves out its classic row. *@
            var tagRoot = TagNav.GetRoot();
            <nav class="page-tags" aria-label="Tags">
                @foreach (var tag in Model.Tags)
                {
                    var tagSlug = ParksComputing.Engine.Pages.Services.ArticleContentService.TagSlug(tag);
                    var menuId = $"tag-menu-{Model.Key}-{tagSlug}";
                    <button type="button" class="tag-link" popovertarget="@menuId">@tag</button>
                    <nav class="menu-panel tag-menu" id="@menuId" popover aria-label="Articles tagged @tag">
                        <div class="md-section-label">Tagged @tag</div>
                        @foreach (var (node, _) in ParksComputing.Engine.Pages.Services.ArticleContentService.TaggedWith(tagRoot, tagSlug))
                        {
                            var date = ParksComputing.Engine.Pages.Services.NavService.EffectiveDate(node);
                            <div class="md-row"><a class="md-item" href="/?open=@node.Slug&top=@node.Slug" data-win-open="@node.Slug">@(node.Title ?? node.Slug)@if (date is not null) {<span class="md-meta">@date.Value.ToString("d MMMM yyyy")</span>}</a></div>
                        }
                    </nav>
                }
            </nav>
        }
        @if (Model.FrameUrl is not null)
        {
            @* A framed external destination: the site asserted it permits
               framing with frame ~true in sitenav. *@
            <iframe class="win-app-frame" src="@Model.FrameUrl" title="@Model.Title"></iframe>
        }
        else if (Model.OwnDocument)
        {
            @* Content with its own scripts or styles gets its page in a
               frame, where they run with a full document lifecycle. *@
            <iframe class="win-app-frame" src="@(Model.PageUrl)?frame" title="@Model.Title"></iframe>
        }
        else if (Model.Parent is null)
        {
            <div class="post-content">
                @if (Model.Created is not null || Model.Updated is not null)
                {
                    var created = Model.Created ?? Model.Updated;
                    <div class="post-meta">
                        <time datetime="@created?.ToString("yyyy-MM-dd")">@created?.ToLongDateString()</time>
                        @if (Model.Updated is not null && Model.Updated != created)
                        {
                            <span class="updated-on">&nbsp;· Updated <time datetime="@Model.Updated?.ToString("yyyy-MM-dd")">@Model.Updated?.ToLongDateString()</time></span>
                        }
                        <a class="post-edit" href="@(AdminConfig.Value.EditOrigin.TrimEnd('/'))/admin/source?slug=@Uri.EscapeDataString(Model.Key)" target="_blank" rel="nofollow noopener">Edit</a>
                    </div>
                }
                <div class="post-body">
                    @Html.Raw(Model.BodyHtml)
                </div>
            </div>
        }
        else
        {
            @Html.Raw(Model.BodyHtml)
        }
    </div>
</section>
