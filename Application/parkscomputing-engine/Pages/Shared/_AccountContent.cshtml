@model ParksComputing.Engine.Pages.Account.IndexModel
@inject Microsoft.Extensions.Options.IOptions<ParksComputing.Engine.Identity.AccountOptions> AccountConfig
@inject Microsoft.Extensions.Options.IOptions<ParksComputing.Engine.Identity.CommentOptions> CommentConfig
@* The Account applet's body (js/account.js), the same on the classic
   /account page and in the window view's Account window. It is PUDL's
   settings panel (0.51.0): a column of cards, each a subject with its title,
   a short description, its controls, a row of actions and a status line
   that says what the last action did, as the Settings applet is laid out.
   Every form works without script; the applet posts them in place and
   fills the status line. *@
<div class="account settings-panel" data-account-panel>
@if (!Model.SignedIn)
{
    <section class="card" aria-labelledby="account-out">
        <h2 class="card-title" id="account-out">Your account</h2>
        <p class="card-desc">You're not signed in.@(AccountConfig.Value.Registration ? " An account lets you comment on articles and keeps your pins on every device." : "")</p>
        <div class="settings-actions">
            <a class="btn btn-primary" href="/account/signin" data-account-dialog>Sign in…</a>
            @if (AccountConfig.Value.Registration)
            {
                <a class="btn" href="/account/register" data-account-dialog>Create an account…</a>
            }
        </div>
    </section>
}
else
{
    @if (Model.SetupPending)
    {
        <div class="notice warn" role="status">
            <div class="notice-content">
                <p class="notice-title">Super-user setup is waiting</p>
                <p class="notice-body">The server operator has authorized this account to become the site's super-user.</p>
                <div class="notice-actions"><a class="btn" href="/account/superuser" data-return-here>Finish super-user setup</a></div>
            </div>
        </div>
    }

    <section class="card" id="profile" aria-labelledby="account-profile">
        <h2 class="card-title" id="account-profile">Profile</h2>
        <p class="card-desc">Your display name is shown beside your comments. Your email address never is.</p>
        <table class="kv-table">
            <tr><th scope="row">Email</th><td>@Model.Email</td></tr>
            <tr><th scope="row">Access</th><td>@Model.Access</td></tr>
        </table>
        <form method="post" asp-antiforgery="true" action="/account?handler=Profile" novalidate>
            <partial name="~/Pages/Account/_AccountErrors.cshtml" />
            <input type="hidden" name="Version" value="@Model.Version" />
            <div class="form-group">
                <label class="form-label" for="account-name">Display name</label>
                <input class="form-input" id="account-name" name="DisplayName" value="@Model.DisplayName" maxlength="80" required />
            </div>
            <div class="settings-actions"><button class="btn" type="submit">Save display name</button></div>
        </form>
        <p class="settings-status" data-account-status role="status"></p>
    </section>

    <section class="card" id="picture" aria-labelledby="account-picture" data-account-avatar-url="@(Model.AvatarUrl ?? "")">
        <h2 class="card-title" id="account-picture">Profile picture</h2>
        <div class="account-picture">
            @ParksComputing.Engine.Identity.AccountMenu.Avatar(Model.AvatarUrl, Model.DisplayName, "xl")
            <p class="card-desc">Shown at the top of every page while you're signed in, and beside your comments. Any picture works; it's cropped to a square and made small before it's sent.</p>
        </div>
        <div class="settings-actions">
            @* With script, Choose a picture… opens the file picker and saves
               the picture as soon as one is chosen; without it, the file
               field and Save picture do. *@
            <form class="account-picture-form" method="post" asp-antiforgery="true" action="/account?handler=Avatar" enctype="multipart/form-data" novalidate data-account-avatar-form>
                <label class="visually-hidden account-js-only" for="account-picture-file">Choose a picture</label>
                <input class="form-file account-no-js" id="account-picture-file" name="Picture" type="file" accept="image/png,image/jpeg,image/webp" required />
                <button class="btn account-js-only" type="button" data-account-choose>@(Model.AvatarUrl is null ? "Choose a picture…" : "Choose a new picture…")</button>
                <button class="btn account-no-js" type="submit">Save picture</button>
            </form>
            @if (Model.AvatarUrl is not null)
            {
                <form method="post" asp-antiforgery="true" action="/account?handler=RemoveAvatar">
                    <button class="btn" type="submit">Remove picture</button>
                </form>
            }
        </div>
        <p class="settings-status" data-account-status role="status"></p>
    </section>

    <section class="card" id="passkeys" aria-labelledby="account-passkeys">
        <h2 class="card-title" id="account-passkeys">Passkeys</h2>
        <p class="card-desc">A passkey signs you in with this device's own lock, such as Windows Hello, Touch ID, your phone's screen lock or a security key, instead of an email link.</p>
        @if (Model.Keys.Count == 0)
        {
            <p>You have no passkeys yet.</p>
        }
        else
        {
            <ul class="account-list">
                @foreach (var key in Model.Keys)
                {
                    <li><span>@key.Name</span><button class="btn btn-sm" type="button" data-remove-key="@key.Id">Remove</button></li>
                }
            </ul>
        }
        <div class="form-group">
            <label class="form-label" for="key-name">Name for a new passkey</label>
            <input class="form-input" id="key-name" maxlength="60" placeholder="For example, Laptop or Phone" aria-describedby="key-name-help" />
            <p class="form-help" id="key-name-help">The name only helps you tell your passkeys apart.</p>
        </div>
        <div class="settings-actions"><button class="btn" type="button" data-passkey="register">Add a passkey…</button></div>
        <p class="form-error" data-passkey-status role="alert" hidden></p>
    </section>

    @if (Model.TokensOffered)
    {
        var mcpUrl = (string.IsNullOrEmpty(AccountConfig.Value.Origin) ? Context.Request.Scheme + "://" + Context.Request.Host : AccountConfig.Value.Origin.TrimEnd('/')) + ParksComputing.Engine.Mcp.McpSetup.Path;
        var nowUtc = DateTime.UtcNow;
        @* Personal access tokens for the site's MCP endpoint (Identity/AccessTokens.cs,
           Architecture/applet-platform-design.md, P3). Making one needs a fresh
           passkey tap; with script the form asks for it first. *@
        <section class="card" id="tokens" aria-labelledby="account-tokens">
            <h2 class="card-title" id="account-tokens">Access tokens</h2>
            <p class="card-desc">An AI client such as Claude Code can work on the site through <code>@mcpUrl</code> with a token made here. A token acts as you, with only the capabilities you give it, until it expires or you revoke it. Its secret is shown once, when it is made.</p>
            @if (Model.NewToken is { } made)
            {
                <div class="notice positive" role="status">
                    <div class="notice-content">
                        <p class="notice-title">The token "@made.Token.Name" is made</p>
                        <p class="notice-body">Copy its secret now. It won't be shown again; if it's lost, revoke the token and make another.</p>
                        <p><code class="account-token-secret">@made.Secret</code></p>
                        <p class="notice-body">To use it from Claude Code:</p>
                        <pre class="account-token-command"><code>claude mcp add --transport http parkscomputing @mcpUrl --header "Authorization: Bearer @made.Secret"</code></pre>
                        <div class="notice-actions"><button class="btn account-js-only" type="button" data-account-copy="@made.Secret">Copy the secret</button></div>
                    </div>
                </div>
            }
            @if (Model.Tokens.Count == 0)
            {
                <p>You have no access tokens.</p>
            }
            else
            {
                <ul class="account-list">
                    @foreach (var t in Model.Tokens)
                    {
                        var state = t.RevokedUtc is not null ? "Revoked" : t.ExpiresUtc <= nowUtc ? "Expired" : "Until " + t.ExpiresUtc.ToString("yyyy-MM-dd");
                        <li>
                            <span>@t.Name <span class="form-help mono">@(t.Prefix)…</span><br />
                                <span class="form-help">@state · @string.Join(", ", t.Capabilities) · @(t.LastUsedUtc is { } used ? "last used " + used.ToString("yyyy-MM-dd HH:mm") + " UTC" : "never used")</span></span>
                            @if (t.Active(nowUtc))
                            {
                                <form method="post" asp-antiforgery="true" action="/account?handler=RevokeToken"><input type="hidden" name="tokenId" value="@t.Id" /><button class="btn btn-sm btn-danger" type="submit">Revoke</button></form>
                            }
                        </li>
                    }
                </ul>
            }
            <form method="post" asp-antiforgery="true" action="/account?handler=CreateToken" data-account-confirm>
                @if (Model.TokenError is not null)
                {
                    <p class="form-error" role="alert">@Model.TokenError</p>
                }
                <div class="form-group">
                    <label class="form-label" for="token-name">Name</label>
                    <input class="form-input" id="token-name" name="TokenName" value="@Model.TokenName" maxlength="80" required placeholder="For example, Claude Code on the laptop" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="token-days">Lasts for</label>
                    <span class="form-select-wrap"><select class="form-select" id="token-days" name="TokenDays">
                        @foreach (var days in ParksComputing.Engine.Identity.AccessTokens.LifetimeDays)
                        {
                            <option value="@days" selected="@(days == Model.TokenDays)">@(days == 365 ? "A year" : days + " days")</option>
                        }
                    </select></span>
                </div>
                <fieldset class="form-group">
                    <legend class="form-label">What it may do</legend>
                    @foreach (var (name, description) in ParksComputing.Engine.Identity.TokenCapabilities.All)
                    {
                        <label class="check account-token-cap">
                            <input type="checkbox" name="TokenCaps" value="@name" checked="@(Model.TokenCaps?.Contains(name) == true)" />
                            <span><span class="mono">@name</span><br /><span class="form-help">@description</span></span>
                        </label>
                    }
                </fieldset>
                <div class="settings-actions"><button class="btn" type="submit">Make a token…</button></div>
            </form>
            <p class="settings-status" data-account-status role="status"></p>
        </section>
    }

    @if (CommentConfig.Value.Enabled && Model.Moderates)
    {
        <section class="card" id="moderation" aria-labelledby="account-moderation">
            <h2 class="card-title" id="account-moderation">Moderation</h2>
            <p class="card-desc">An email comes only when something new has arrived since you last opened the queue. It gives counts and article titles, not the comments.</p>
            @* How often a moderator is emailed about what is waiting (Identity/ModerationNotices.cs). *@
            <form method="post" asp-antiforgery="true" action="/account?handler=Notices">
                <div class="form-group">
                    <label class="form-label" for="account-notices">Email me when comments are waiting</label>
                    <span class="form-select-wrap"><select class="form-select" id="account-notices" name="minutes">
                        @foreach (var (minutes, label) in ParksComputing.Engine.Identity.ModerationNotices.Intervals)
                        {
                            <option value="@minutes" selected="@(minutes == Model.NoticeInterval)">@label</option>
                        }
                    </select></span>
                </div>
                <div class="settings-actions">
                    <button class="btn" type="submit">Save</button>
                    <a class="btn" href="/moderation" data-win-open="moderation">Open the moderation queue</a>
                </div>
            </form>
            <p class="settings-status" data-account-status role="status"></p>
        </section>
    }

    @if (CommentConfig.Value.Enabled)
    {
        <section class="card" id="comments" aria-labelledby="account-comments">
            <h2 class="card-title" id="account-comments">Your comments</h2>
            @if (Model.Comments.Count == 0)
            {
                <p class="card-desc">You haven't commented yet. Every comment is read by a moderator before it appears.</p>
            }
            else
            {
                <ul class="account-list account-comments">
                    @foreach (var c in Model.Comments)
                    {
                        var status = c.Status switch {
                            "published" => "Published", "pending" => "Waiting for a moderator", "edit-pending" => "Published; your edit is waiting for a moderator",
                            "declined" => "Not approved", "withdrawn" => "Withdrawn", "removed" => "Removed by a moderator", _ => c.Status };
                        <li>
                            <span>
                                @* In the window view the article opens as a window, its comments under it. *@
                                <a href="/comments/@c.Slug#c-@c.Id" data-win-open="@c.Slug">@c.Title</a><br />
                                <span class="form-help">@status · <time datetime="@c.CreatedUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">@c.CreatedUtc.ToString("d MMMM yyyy")</time></span>
                            </span>
                        </li>
                    }
                </ul>
            }
        </section>
    }

    <section class="card" id="sessions" aria-labelledby="account-sessions">
        <h2 class="card-title" id="account-sessions">Where you're signed in</h2>
        <p class="card-desc">Ending a session signs that browser out the next time it asks this site for anything.</p>
        <ul class="account-list">
            @foreach (var session in Model.Sessions)
            {
                <li>
                    <span>@(session.Id == Model.CurrentSession ? "This browser" : "Another browser")<br />
                        <span class="form-help">Signed in <time datetime="@session.StartedUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">@session.StartedUtc.ToString("yyyy-MM-dd HH:mm") UTC</time> with @ParksComputing.Engine.Identity.AdminSessions.Describe(session.Method)</span></span>
                    @if (session.Id != Model.CurrentSession)
                    {
                        <form method="post" asp-antiforgery="true" action="/account?handler=Revoke"><input type="hidden" name="sessionId" value="@session.Id" /><button class="btn btn-sm btn-danger" type="submit">End session</button></form>
                    }
                </li>
            }
        </ul>
        <div class="settings-actions">
            <form method="post" asp-antiforgery="true" action="/account/signout"><button class="btn" type="submit">Sign out of this browser</button></form>
        </div>
        <p class="settings-status" data-account-status role="status"></p>
    </section>

    <section class="card" id="your-data" aria-labelledby="account-data">
        <h2 class="card-title" id="account-data">Your data</h2>
        <p class="card-desc">Download everything this site holds about your account: your email address, profile, picture, passkey names, sessions, pins, and every version of your comments. The <a href="/privacy" data-win-open="privacy">privacy policy</a> says how it's used.</p>
        <div class="settings-actions"><a class="btn" href="/account?handler=Export" download>Download your data</a></div>
    </section>

    <section class="card" id="delete" aria-labelledby="account-delete">
        <h2 class="card-title" id="account-delete">Delete your account</h2>
        <p class="card-desc">Deleting your account removes your email address, passkeys, sessions, pins and picture, and erases the text of your comments. Where someone replied to one of your comments, a note says it was withdrawn. It can't be undone, so the site first emails you a link to confirm it.</p>
        @if (Model.DeletionSent)
        {
            <div class="notice positive" role="status"><div class="notice-content"><p class="notice-body">Check your email. The link to confirm deleting your account works once, within 15 minutes.</p></div></div>
        }
        else
        {
            @if (Model.DeletionRefusal is not null)
            {
                <p class="form-error" role="alert">@Model.DeletionRefusal</p>
            }
            <form method="post" asp-antiforgery="true" action="/account?handler=RequestDeletion">
                <div class="settings-actions"><button class="btn btn-danger" type="submit">Email me a link to delete my account…</button></div>
            </form>
        }
    </section>
}
</div>
