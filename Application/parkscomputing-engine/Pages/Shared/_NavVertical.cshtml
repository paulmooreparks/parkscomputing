@model ParksComputing.Engine.Pages.Models.NavContentModel
@{
    var navNode = Model.NavNode;
    var containerClass = Model.GetContainerCssClass();
}

@if (navNode != null)
{
    <ul class="@containerClass list-unstyled">
        @if (Model.ShowRoot)
        {
            var rootTip = Model.ShowDescriptions ? (navNode.Description ?? navNode.Excerpt ?? navNode.Title ?? string.Empty) : "";
            <li class="nav-vertical-item">
                <a class="nav-vertical-link" href="@navNode.Url">@navNode.Title</a>
                @if (Model.ShowDescriptions && !string.IsNullOrEmpty(rootTip))
                {
                    <div class="nav-vertical-description">@rootTip</div>
                }
            </li>
        }

        @if (navNode.Nav != null && Model.MaxDepth > 0)
        {
            @foreach (var link in navNode.Nav)
            {
                var linkTip = Model.ShowDescriptions ? (link?.Description ?? link?.Excerpt ?? link?.Title ?? string.Empty) : "";
                <li class="nav-vertical-item">
                    <a class="nav-vertical-link" href="@link?.Url">@link?.Title</a>
                    @if (Model.ShowDescriptions && !string.IsNullOrEmpty(linkTip))
                    {
                        <div class="nav-vertical-description">@linkTip</div>
                    }

                    @if (link?.Nav != null && link.Nav.Length > 0 && Model.MaxDepth > 1)
                    {
                        <ul class="nav-vertical-submenu list-unstyled">
                            @foreach (var sublink in link.Nav)
                            {
                                var subTip = Model.ShowDescriptions ? (sublink?.Description ?? sublink?.Excerpt ?? sublink?.Title ?? string.Empty) : "";
                                if (sublink != null)
                                {
                                    <li class="nav-vertical-subitem">
                                        <a class="nav-vertical-sublink" href="@sublink.Url"
                                           @if (!string.IsNullOrEmpty(sublink.Target)) {
                                               <text>target="@sublink.Target"</text>
                                           }>@sublink.Title</a>
                                        @if (Model.ShowDescriptions && !string.IsNullOrEmpty(subTip))
                                        {
                                            <div class="nav-vertical-sub-description">@subTip</div>
                                        }
                                    </li>
                                }
                            }
                        </ul>
                    }
                </li>
            }
        }
    </ul>
}
