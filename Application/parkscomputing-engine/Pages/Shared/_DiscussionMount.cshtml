@model string
@inject ParksComputing.Engine.Identity.CommentPolicies Policies
@inject Microsoft.Extensions.Options.IOptions<ParksComputing.Engine.Identity.AccountOptions> AccountConfig
@inject Microsoft.Extensions.Options.IOptions<ParksComputing.Engine.Identity.CommentOptions> CommentConfig
@* Under an article that takes comments, in both views
   (Architecture/unified-identity-design.md, step 2): a mount the comments
   applet fills with the discussion as this reader sees it, so the article
   itself stays the same for everyone. Without script, the link leads to the
   discussion's own page. *@
@if (AccountConfig.Value.Enabled && CommentConfig.Value.Enabled && Policies.Of(Model) is { } info && info.Policy != ParksComputing.Engine.Publishing.ArticleCommentPolicy.Disabled)
{
    <section class="discussion-mount" aria-label="Comments">
        <div data-applet="comments" data-discussion="@info.Slug">
            <p><a href="/comments/@info.Slug">Read the comments on this article</a></p>
        </div>
    </section>
}
