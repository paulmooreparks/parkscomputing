@using ParksComputing.Engine.Pages.Services
@using ParksComputing.Engine.Identity
@inject INavService SiteNav
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@* The site's host menu, for PUDL's menu bar (pudl-menubar.js; see
   Architecture/site-menu-design.md): sitenav.xfer's menu, resolved by
   SiteMenu and written by MenuBuilder as the hidden nested list PUDL reads
   into the logo menu. PUDL presses each link or button for the reader, so
   a page of the site still opens as a window in the window view, and
   js/commands.js carries out the commands that need script. The front
   menu, for what the reader is in, is PUDL's to build from the applet or
   the article. Where the site has accounts, the logo's title ends with the
   account's commands, which the layout worked out (Identity/AccountMenu). *@
@{
    bool desktop = ViewData["Desktop"] as bool? ?? false;
    var accountState = ViewData["AccountMenu"] as AccountMenuState ?? AccountMenuState.Off;
    // Which stage this server is, beta or production, for an entry's when
    // (Architecture/site-menu-design.md); production unless Site:Stage says otherwise.
    var stage = Config["Site:Stage"];
}
@Html.Raw(MenuBuilder.ToHtml(SiteMenu.Build(SiteNav.GetRoot(), desktop, AccountMenu.Entries(accountState, desktop), stage, accountState.Roles)))
