@model ParksComputing.Engine.Pages.Services.CommentForm

<div class="page-post-comment">
    <h3>Share Your Thoughts</h3>
    <form method="post">
        <div class="form-group">
            <label class="form-label" for="name">Name</label>
            <input class="form-input" id="name" name="Name" required asp-for="Name">
        </div>

        <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <input class="form-input" id="email" type="email" name="Email" required asp-for="Email">
        </div>

        <div class="form-group">
            <label class="form-label" for="comment-title">Title</label>
            <input class="form-input" id="comment-title" name="Title" required asp-for="Title">
        </div>

        <div class="form-group">
            <label class="form-label" for="comment-text">Comment</label>
            <textarea class="form-textarea" id="comment-text" name="Text" required asp-for="Text"></textarea>
        </div>

        <button class="btn btn-primary" type="submit">Submit Comment</button>
    </form>
</div>
