@model ParksComputing.Engine.Pages.Models.TaskbarModel
@* The taskbar (Architecture/admin-and-identity-design.md, A12), with
   js/taskbar.js and css/taskbar.css. It holds nothing of the page it sits
   on, so any page of PUDL windows can render it with its own Start menu.
   The dock and the minimize and restore links are PUDL's (data-win-dock,
   data-win-back, data-win-restore), which PUDL keeps pointed at the state
   they produce. *@
<footer class="pc-taskbar" aria-label="Taskbar">
    <div class="menu pc-start">
        <button type="button" class="btn menu-btn pc-start-btn" popovertarget="pc-start-menu">@Model.StartLabel</button>
        <nav class="menu-panel pc-start-menu" id="pc-start-menu" popover aria-label="@Model.StartLabel">
            @foreach (var entry in Model.Entries)
            {
                <div class="md-row">
                    <a class="md-item pc-start-item" href="@entry.Href"
                       @(entry.Window is null ? null : Html.Raw($"data-win-open=\"{entry.Window}\""))
                       @(entry.Request is null ? null : Html.Raw($"data-taskbar-request=\"{entry.Request}\""))><span class="glyph" style="--glyph: var(--glyph-@entry.Glyph)" aria-hidden="true"></span>@entry.Label</a>
                </div>
            }
        </nav>
    </div>
    <nav class="win-dock pc-taskbar-dock" data-win-dock aria-label="Open windows"></nav>
    <a class="icon-btn min-all" data-win-back href="?" aria-disabled="true"
       aria-label="Minimize all windows" title="Minimize all windows"><svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1.5" y="1.5" width="13" height="9" rx="1.5"/><line x1="4.5" y1="14" x2="11.5" y2="14"/><path d="M6 5.5l2 2 2-2"/></svg></a>
    <a class="icon-btn restore-all" data-win-restore href="?" aria-disabled="true"
       aria-label="Restore all windows" title="Restore all windows"><svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1.5" y="1.5" width="13" height="9" rx="1.5"/><line x1="4.5" y1="14" x2="11.5" y2="14"/><path d="M6 7.5l2-2 2 2"/></svg></a>
    <a class="icon-btn close-all is-disabled" data-close-all href="?open=" aria-disabled="true" tabindex="-1"
       aria-label="Close all windows" title="Close all windows"><svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1.5" y="4.5" width="9" height="9" rx="1.5"/><path d="M5.5 4V3a1.5 1.5 0 0 1 1.5-1.5h6A1.5 1.5 0 0 1 14.5 3v6A1.5 1.5 0 0 1 13 10.5h-1"/><line x1="4" y1="7" x2="8" y2="11"/><line x1="8" y1="7" x2="4" y2="11"/></svg></a>
</footer>
