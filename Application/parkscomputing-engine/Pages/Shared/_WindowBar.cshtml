@model ParksComputing.Engine.Pages.Models.WindowBarModel
@* The window bar, at the foot of the window area of both sites' pages of
   windows (Paul, 2026-10-01; it was in the top bar before). It is PUDL's
   taskbar (0.79.0, a preview; Architecture/pudl-0.79-integration.md): the
   site's sidebar toggle, PUDL's dock of open windows, and minimize all,
   restore all and close all (data-win-back, data-win-restore and
   data-win-close-all), which PUDL keeps pointed at the state they produce,
   marks aria-disabled while they would change nothing, and draws with its
   own glyphs, since they have no picture of their own. Each is a link to
   that state for a reader without script. It knows nothing of the page it
   sits on. *@
<div class="win-bar">
    @if (ViewData["Launcher"] as bool? == true)
    {
    <button class="icon-btn win-bar-launcher" id="taskbar-launcher" type="button" popovertarget="site-launcher"
            aria-label="Open launcher" data-tooltip="Open launcher">
        <span class="glyph" style="--glyph:var(--glyph-app)" aria-hidden="true"></span>
    </button>
    }
    else
    {
    <button class="icon-btn sidebar-toggle" type="button" data-sidebar-toggle hidden
            aria-label="Hide sidebar" data-tooltip="Hide sidebar" aria-expanded="true" aria-pressed="false">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
            <rect x="1.5" y="2" width="13" height="12" rx="1.5" />
            <path d="M6 2v12" /><path class="sidebar-glyph-pane" d="M2 2.5h3.5v11H2z" stroke="none" />
        </svg>
    </button>
    }
    <nav class="win-dock" data-win-dock aria-label="Open windows"></nav>
    <a class="icon-btn" data-win-back href="@Model.MinimizeAllUrl"
       @(Model.AnyShowing ? null : Html.Raw("aria-disabled=\"true\""))
       aria-label="Minimize all windows" data-tooltip="Minimize all windows"></a>
    <a class="icon-btn" data-win-restore href="@Model.RestoreAllUrl"
       @(Model.AnyMinimized ? null : Html.Raw("aria-disabled=\"true\""))
       aria-label="Restore all windows" data-tooltip="Restore all windows"></a>
    <a class="icon-btn" data-win-close-all href="@Model.CloseAllUrl"
       @(Model.AnyOpen ? null : Html.Raw("aria-disabled=\"true\""))
       aria-label="Close all windows" data-tooltip="Close all windows"></a>
</div>
