@using ParksComputing.Engine.Identity
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@inject Microsoft.Extensions.Options.IOptions<AdminOptions> AdminConfig
@inject AdminMenu AdminMenus
@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> Users
@{
    // The edit origin's pages (Architecture/admin-and-identity-design.md, A5).
    // No inline script anywhere, so the origin's Content-Security-Policy can
    // allow scripts from itself alone. While signed in, the bar says so on
    // every page, as a root shell's prompt does (A9). The logo is the admin
    // menu (A15), written in /etc/admin-menu.xfer or the admin's own
    // ~/.config/admin-menu.xfer. The desktop at /admin (A12) is the
    // workspace: the tools as windows over the admin mount (A7), with the
    // window bar beside the menu. Each tool also has a page of its own, for
    // a link or a tab.
    bool signedIn = User.IsInRole(AdminOptions.Role);
    string? method = User.FindFirst(AdminSessions.MethodClaim)?.Value;
    bool workspace = signedIn && ViewData["Workspace"] as bool? == true;
    bool desktop = workspace && ViewData["Desktop"] as bool? == true;
    string publicOrigin = AdminConfig.Value.PublicOrigin.TrimEnd('/');
    IReadOnlyList<ParksComputing.Engine.Pages.Services.MenuTitle> menu = Array.Empty<ParksComputing.Engine.Pages.Services.MenuTitle>();
    string? homeName = null;
    if (signedIn && await Users.GetUserAsync(User) is { } me)
    {
        homeName = ServerFiles.HomeNameOf(me);
        menu = AdminMenus.For(homeName, desktop);
    }
}
@{
    /* One row of the logo button that shows before the menu bar is built:
       the entry's own element, which is a link, or for signing out a button
       naming the form below. */
    void FallbackRow(ParksComputing.Engine.Pages.Services.MenuEntry item)
    {
        if (item.Element is null) { return; }
        var icon = string.IsNullOrEmpty(item.Icon)
            ? Html.Raw("<span class=\"admin-menu-icon\" aria-hidden=\"true\"></span>")
            : Html.Raw($"<img class=\"admin-menu-icon\" src=\"{System.Net.WebUtility.HtmlEncode(item.Icon)}\" alt=\"\" />");
        var cls = "md-item admin-menu-item" + (item.Element.Tag == "button" ? " admin-menu-signout" : "");
        <div class="md-row">@Html.Raw(item.Element.Open(cls, item.Description))@icon@item.Label@Html.Raw(item.Element.Close())</div>
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="request-verification-token" content="@Xsrf.GetAndStoreTokens(Context).RequestToken" />
    @if (workspace)
    {
        @* js/sitefs.js mounts /wwwroot and /home from this API; js/applets.js
           points the workspace applets at their pages here; pages and the
           other applets open on the public site. *@
        <meta name="pc-fs-mount" content="/api/admin/fs" />
        <meta name="pc-applet-pages" content="/admin/" />
        <meta name="pc-public-origin" content="@publicOrigin" />
        @* The terminal's ssh and ssh-key (A16), which the server sends to an
           admin only; the name goes in the SSH key's comment. *@
        <meta name="pc-ssh-commands" content="/admin/ssh/ssh-command.js" />
        <meta name="pc-admin-name" content="@homeName" />
    }
    @if (desktop)
    {
        @* The desktop's side holds the file tree, so the Editor's own
           Explorer pane starts hidden there. *@
        <meta name="pc-file-sidebar" content="1" />
    }
    <title>@ViewData["Title"] · Editing parkscomputing.com</title>
    <script src="~/pudl/pudl-theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/pudl/pudl.css" asp-append-version="true" />
    @if (desktop)
    {
        <link rel="stylesheet" href="~/pudl/pudl-windows.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/window-bar.css" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
</head>
<body class="admin@(signedIn ? " admin-elevated" : null)@(workspace ? " admin-workspace" : null)@(desktop ? " admin-desktop" : null)">
    <header class="admin-bar">
        @if (signedIn)
        {
            @* The menu bar, as on the public site (PUDL 0.38.0,
               Architecture/menu-bar-design.md and site-menu-design.md): the
               host menu is /etc/admin-menu.xfer, or the admin's own
               ~/.config/admin-menu.xfer, resolved by AdminMenu and written
               as the hidden list pudl-menubar.js reads. The logo button
               after it is what shows before the script has built the bar.
               Off the desktop the logo's first row goes back to it. Signing
               out is a form, since it changes state, so its row is a button
               naming the form below. *@
            <nav class="admin-menubar" data-menubar aria-label="Parks Computing Admin">
            @Html.Raw(ParksComputing.Engine.Pages.Services.MenuBuilder.ToHtml(menu))
            <div class="menu admin-logo">
                <button type="button" class="brand topbar-pill menu-btn admin-logo-btn" popovertarget="admin-menu" aria-label="Parks Computing Admin menu">
                    <img src="/favicon-32x32.png" alt="" width="22" height="22" /> <span class="admin-logo-name">Parks Computing Admin</span>
                </button>
                <nav class="menu-panel admin-menu" id="admin-menu" popover aria-label="Parks Computing Admin">
                    @foreach (var entry in menu.FirstOrDefault()?.Entries ?? Array.Empty<ParksComputing.Engine.Pages.Services.MenuEntry>())
                    {
                        if (entry.Kind == ParksComputing.Engine.Pages.Services.MenuEntryKind.Heading)
                        {
                            <div class="md-section-label">@entry.Label</div>
                            foreach (var item in entry.Entries ?? Array.Empty<ParksComputing.Engine.Pages.Services.MenuEntry>()) { FallbackRow(item); }
                        }
                        else if (entry.Kind == ParksComputing.Engine.Pages.Services.MenuEntryKind.Item) { FallbackRow(entry); }
                    }
                </nav>
            </div>
            </nav>
            <form id="admin-signout" method="post" asp-page="/Admin/SignOut" hidden></form>
            <span class="topbar-rule" aria-hidden="true"></span>
            @* Who is signed in, on every page, as a root prompt shows it. A
               fallback session says so where it is always seen, since it
               can't change sign-in methods (A8). *@
            <span class="admin-bar-who" title="Admin: @User.Identity?.Name, signed in with @AdminSessions.Describe(method)">
                <span class="glyph" style="--glyph: var(--glyph-warning)" aria-hidden="true"></span>
                @User.Identity?.Name
                @if (method != AdminSessions.Passkey)
                {
                    <span class="admin-bar-fallback">with @AdminSessions.Describe(method)</span>
                }
            </span>
        }
        else
        {
            <span class="brand admin-bar-title"><img src="/favicon-32x32.png" alt="" width="20" height="20" /> Parks Computing Admin</span>
        }
    </header>
    @if (desktop)
    {
        @RenderBody()
    }
    else
    {
        <main class="admin-main">
            @RenderBody()
        </main>
    }
    <p class="visually-hidden" role="status" aria-live="polite" data-admin-status></p>
    <script src="~/js/admin.js" asp-append-version="true" defer></script>
    @if (signedIn)
    {
        <script src="~/pudl/pudl-menu.js" defer asp-append-version="true"></script>
    }
    @if (workspace)
    {
        <script src="~/js/continuity.js" asp-append-version="true"></script>
        <script src="~/js/window-bar.js" asp-append-version="true"></script>
        @if (desktop)
        {
            <script src="~/pudl/pudl-windows.js" defer asp-append-version="true"></script>
            <script src="~/pudl/pudl-md.js" defer asp-append-version="true"></script>
        }
        <script src="~/pudl/pudl-applets.js" defer asp-append-version="true"></script>
        <script src="~/js/applets.js" defer asp-append-version="true"></script>
        <script src="~/pudl/pudl-dialog.js" defer asp-append-version="true"></script>
        <script src="~/pudl/pudl-tabs.js" defer asp-append-version="true"></script>
        <script src="~/pudl/pudl-tree.js" defer asp-append-version="true"></script>
        <script src="~/pudl/pudl-split.js" defer asp-append-version="true"></script>
        <script src="~/pudl/pudl-grid.js" defer asp-append-version="true"></script>
        @if (desktop)
        {
            <script src="~/js/admin-desktop.js" defer asp-append-version="true"></script>
        }
    }
    @if (signedIn)
    {
        @* The menu bar, after the scripts it uses (PUDL 0.38.0). *@
        <script src="~/pudl/pudl-menubar.js" defer asp-append-version="true"></script>
        <script src="~/js/commands.js" defer asp-append-version="true"></script>
    }
</body>
</html>
