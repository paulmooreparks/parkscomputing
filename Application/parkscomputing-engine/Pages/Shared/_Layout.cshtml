@using System
@using System.Linq
@using ParksComputing.Engine.Pages.Services
@inject StaticFileReaderService FileReaderService
@inject INavService PaletteNav

@{
    bool mdFlag = ViewData["IsMarkdown"] as bool? ?? false;
    string? contentFormat = ViewData["ContentFormat"] as string;
    bool hasMermaid = ViewData["HasMermaid"] as bool? ?? false;
    bool isDesktop = ViewData["Desktop"] as bool? ?? false;
    // ?frame renders the page bare, for hosting inside a desktop window.
    bool isFrame = Context.Request.Query.ContainsKey("frame");
    bool isMarkdown = (contentFormat?.Equals("markdown", System.StringComparison.OrdinalIgnoreCase) ?? false) || mdFlag;
    if (!isMarkdown && (ViewData["HasCodeBlocks"] as bool? ?? false)) { isMarkdown = true; }
    // The desktop loads articles into windows, so it always needs the
    // highlighting assets.
    bool needsHighlight = isMarkdown || isDesktop;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"]</title>

    @* Every PUDL asset is version-stamped: a pinned-dist upgrade must
       reach every browser at once, or a stale script meets fresh markup. *@
    <script src="~/pudl/pudl-theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/pudl/pudl.css" asp-append-version="true" />
    @if (isDesktop)
    {
        <link rel="stylesheet" href="~/pudl/pudl-windows.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/pudl-site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/accessibility.css" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed for @ViewData["Title"]" href="/rss">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    @RenderSection("Meta", required: false)
    @RenderSection("Links", required: false)
    @RenderSection("Style", required: false)
    @RenderSection("HeadScripts", required: false)
    <link rel="manifest" href="/site.webmanifest">

    @{
        bool hasAudio = ViewData["HasAudio"] as bool? ?? false;
    }
    @if (hasAudio)
    {
        <link rel="stylesheet" href="/css/accessible-audio-player.css" />
        <script src="/js/accessible-audio-player.js" defer></script>
    }

    @Html.RenderStaticFile("/content/head-section.html", FileReaderService)
    @if (needsHighlight)
    {
        @* Highlighted code takes PUDL's syntax tokens (0.26.0), so it
           follows the site's theme switch as well as the system's. *@
        <link rel="stylesheet" href="~/pudl/pudl-hljs.css" asp-append-version="true" />
        <script src="/highlightjs/highlight.min.js"></script>
        @if (hasMermaid || isDesktop)
        {
            <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
        }
    }
</head>
<body class="@(isDesktop ? "desktop" : null)">
    @if (!isFrame)
    {
    <header class="site-header">
        @Html.RenderStaticFile("/content/header-section.html", FileReaderService)
        <div class="topbar">
            <a class="brand" href="/"><img src="~/favicon-32x32.png" alt="" /> Parks Computing</a>
            @* The view switcher: one segmented control, centered. Each side
               is a link, because each view is a URL; ?view=window bypasses
               a classic default-view choice. *@
            <nav class="seg view-seg" aria-label="View">
                <a href="/?view=window" aria-current="@(isDesktop ? "true" : null)">Window</a>
                <a href="/home" aria-current="@(isDesktop ? null : "true")">Classic</a>
            </nav>
            <div class="topbar-chrome">
                <button class="theme-toggle" type="button" title="Settings" aria-label="Settings"
                        data-settings-open command="show-modal" commandfor="settings-dialog">⚙</button>
            </div>
        </div>
        @if (!isDesktop)
        {
            <nav class="site-nav app-section-bar" aria-label="Site">
                @await Component.InvokeAsync("Nav")
            </nav>
        }
    </header>
    }

    @if (isDesktop)
    {
        @RenderBody()
    }
    else
    {
        <div class="site-main @(isFrame ? "site-main-framed" : null)">
            @if (!isFrame)
            {
                @Html.RenderStaticFile("/content/main-section.html", FileReaderService)
            }

            <div class="content-body" role="main" id="main-content" tabindex="-1">
                @RenderBody()
                @{
                    string pageIdLocal = ViewData["PageId"]?.ToString()!;
                    bool commentsEnabled = ViewData["CommentsEnabled"] as bool? ?? false;
                    bool commentsAllowed = ViewData["CommentsAllowed"] as bool? ?? false;
                }
                @await Component.InvokeAsync("Comments", new { pageId = pageIdLocal, commentsEnabled = commentsEnabled, commentsAllowed = commentsAllowed, commentPosted = (ViewData["CommentPosted"] as bool? ?? false) })
            </div>
        </div>

        if (!isFrame)
        {
        <footer class="site-footer">
            @Html.RenderStaticFile("/content/footer-section.html", FileReaderService)
        </footer>
        }
    }

    @* The image lightbox, for both views: server-rendered per PUDL, filled
       and shown by lightbox.js. The stage scrolls when an image is zoomed
       to its full size. *@
    <dialog class="lightbox" id="image-lightbox" aria-label="Image viewer">
        <div class="lightbox-stage"><img class="lightbox-img" src="" alt=""></div>
        <div class="lightbox-bar">
            <span class="lightbox-caption"></span>
            <span class="lightbox-counter num"></span>
        </div>
        <button type="button" class="lightbox-btn lightbox-close" aria-label="Close" title="Close (Esc)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
        <button type="button" class="lightbox-btn lightbox-prev" aria-label="Previous image" title="Previous (Left arrow)" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" class="lightbox-btn lightbox-next" aria-label="Next image" title="Next (Right arrow)" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
    </dialog>

    @* The settings dialog: a native <dialog> per PUDL 0.16.0, opened by the
       gear's command button (pudl-dialog.js supplies command in browsers
       that lack it). Everything in it lives only in this browser's own
       storage. *@
    <dialog class="dialog" id="settings-dialog" aria-labelledby="settings-title">
            <h3 class="dialog-title" id="settings-title">Settings</h3>
            <div class="dialog-body">
                <div class="form-group">
                    <span class="form-label" id="theme-label">Theme</span>
                    <div class="seg" role="group" aria-labelledby="theme-label">
                        <button type="button" data-theme-choice="light">Light</button>
                        <button type="button" data-theme-choice="dark">Dark</button>
                        <button type="button" data-theme-choice="system">System</button>
                    </div>
                </div>
                <div class="form-group">
                    <span class="form-label" id="view-label">Default view</span>
                    <div class="seg" role="group" aria-labelledby="view-label">
                        <button type="button" data-view-choice="window">Window</button>
                        <button type="button" data-view-choice="classic">Classic</button>
                    </div>
                </div>
                @if (isDesktop)
                {
                    <div class="form-group">
                        <label class="check"><input type="checkbox" data-pref="maximize-new"> Maximize new windows</label>
                    </div>
                    <div class="form-group">
                        <label class="check"><input type="checkbox" data-pref="resume-windows" data-pref-default="1"> Reopen last session&#8217;s windows</label>
                    </div>
                }
                <p class="settings-note">These choices, and the window arrangement, are kept only in this browser.</p>
            </div>
            <div class="dialog-actions">
                <button class="btn btn-danger" type="button" data-settings-forget>⚠ Forget this browser&#8217;s data</button>
                <button class="btn btn-primary" type="button" command="close" commandfor="settings-dialog" data-settings-close>Close</button>
            </div>
    </dialog>

    @if (!isFrame)
    {
        @* The go palette, PUDL 0.17.0: a buttonless menu panel summoned by
           '/', opening top-centre with focus in its filter. Typing narrows
           the rows; Enter follows the remaining row, or, with none left,
           submits the form to /go, which redirects by slug, so unlisted
           pages stay reachable. *@
        <nav class="menu-panel go-palette" popover data-menu-key="/" aria-label="Go to page">
            <form action="/go" method="get" role="search">
                <input class="md-filter" type="search" name="slug" placeholder="Go to&#8230;" aria-label="Go to page" autocomplete="off" spellcheck="false" />
                @if (!isDesktop)
                {
                    <input type="hidden" name="nav" value="1" />
                }
                else
                {
                    @* The desktop's state rides along, so /go adds the new
                       window to what is open instead of replacing it. The
                       fields are server-rendered as of this page load and
                       desktop.js refreshes them when the form submits. *@
                    foreach (var stateParam in Context.Request.Query)
                    {
                        if (stateParam.Key is "slug" or "nav" or "view") { continue; }
                        foreach (var stateValue in stateParam.Value)
                        {
                            <input type="hidden" data-go-state name="@stateParam.Key" value="@stateValue" />
                        }
                    }
                }
            </form>
            @{
                var paletteRoot = PaletteNav.GetRoot();
                string PaletteHref(string slug) => isDesktop ? $"/?open={slug}&top={slug}" : $"/page/{slug}";
            }
            @if (paletteRoot.Posts is { Length: > 0 })
            {
                <div class="md-section-label">Articles</div>
                foreach (var post in paletteRoot.Posts
                    .Where(p => !string.IsNullOrEmpty(p.Slug))
                    .OrderByDescending(p => NavService.EffectiveDate(p) ?? DateTime.MinValue))
                {
                    <div class="md-row"><a class="md-item" href="@PaletteHref(post.Slug!)"
                        @(isDesktop ? Html.Raw($"data-win-open=\"{post.Slug}\"") : null)>@(post.Title ?? post.Slug)</a></div>
                }
            }
            @foreach (var paletteSection in paletteRoot.Nav ?? Array.Empty<NavNode>())
            {
                if (paletteSection.Nav is not { Length: > 0 }) { continue; }
                <div class="md-section-label">@paletteSection.Title</div>
                foreach (var item in paletteSection.Nav)
                {
                    if (string.IsNullOrEmpty(item.Slug)) { continue; }
                    if (item.External || (item.Url?.StartsWith("http", StringComparison.OrdinalIgnoreCase) ?? false))
                    {
                        <div class="md-row"><a class="md-item" href="@item.Url" target="_blank" rel="noopener">@(item.Title ?? item.Slug)</a></div>
                    }
                    else
                    {
                        <div class="md-row"><a class="md-item" href="@PaletteHref(item.Slug)"
                            @(isDesktop ? Html.Raw($"data-win-open=\"{item.Slug}\"") : null)>@(item.Title ?? item.Slug)</a></div>
                    }
                }
            }
            @{
                var paletteLeaves = (paletteRoot.Nav ?? Array.Empty<NavNode>())
                    .Where(n => n.Nav is not { Length: > 0 } && !string.IsNullOrEmpty(n.Slug)).ToList();
            }
            @if (paletteLeaves.Count > 0)
            {
                <div class="md-section-label">Pages</div>
                foreach (var leaf in paletteLeaves)
                {
                    if (!string.IsNullOrEmpty(leaf.Url) && leaf.Url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="md-row"><a class="md-item" href="@leaf.Url" target="_blank" rel="noopener">@(leaf.Title ?? leaf.Slug)</a></div>
                    }
                    else
                    {
                        <div class="md-row"><a class="md-item" href="@PaletteHref(leaf.Slug!)"
                            @(isDesktop ? Html.Raw($"data-win-open=\"{leaf.Slug}\"") : null)>@(leaf.Title ?? leaf.Slug)</a></div>
                    }
                }
            }
        </nav>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/lightbox.js" asp-append-version="true"></script>
    @if (isDesktop)
    {
        <script src="~/js/desktop.js" asp-append-version="true"></script>
        <script src="~/pudl/pudl-windows.js" defer asp-append-version="true"></script>
        <script src="~/pudl/pudl-regions.js" defer asp-append-version="true"></script>
        <script src="~/pudl/pudl-md.js" defer asp-append-version="true"></script>
    }
    @* The menu script loads everywhere since 0.17.0: the go palette is a
       key-summoned menu panel on every page. *@
    <script src="~/pudl/pudl-menu.js" defer asp-append-version="true"></script>
    <script src="~/pudl/pudl-applets.js" defer asp-append-version="true"></script>
    <script src="~/js/applets.js" defer asp-append-version="true"></script>
    <script src="~/pudl/pudl-dialog.js" defer asp-append-version="true"></script>
    @* Document tabs, trees and grids, for the Editor and Files applets,
       which can open on any page. *@
    <script src="~/pudl/pudl-tabs.js" defer asp-append-version="true"></script>
    <script src="~/pudl/pudl-tree.js" defer asp-append-version="true"></script>
    <script src="~/pudl/pudl-grid.js" defer asp-append-version="true"></script>
    @RenderSection("BodyScripts", required: false)
    @if (isMarkdown)
    {
        <script>
            (function () {
                function renderMarkdownEnhancements() {
                    document.querySelectorAll('pre > code.language-mermaid, pre > code[class*="language-mermaid"]').forEach(function (codeBlock) {
                        var pre = codeBlock.parentElement;
                        if (!pre) { return; }

                        var mermaidNode = document.createElement('div');
                        mermaidNode.className = 'mermaid';
                        mermaidNode.textContent = codeBlock.textContent || '';
                        pre.replaceWith(mermaidNode);
                    });

                    if (window.mermaid && document.querySelector('.mermaid')) {
                        window.mermaid.initialize({ startOnLoad: false });
                        window.mermaid.run({ querySelector: '.mermaid' });
                    }

                    if (window.hljs) {
                        document.querySelectorAll('pre code:not(.language-mermaid)').forEach(function (block) {
                            window.hljs.highlightElement(block);
                        });
                    }
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', renderMarkdownEnhancements);
                } else {
                    renderMarkdownEnhancements();
                }
            })();
        </script>
    }
</body>
</html>
