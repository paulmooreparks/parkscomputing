@using System
@using System.Linq
@using ParksComputing.Engine.Pages.Services
@inject StaticFileReaderService FileReaderService
@inject INavService PaletteNav
@inject ParksComputing.Engine.Identity.AccountMenu AccountMenu
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject ParksComputing.Engine.Identity.AccountPins PinStore
@inject ArticleContentService PinArticles

@{
    // Where the site has accounts, what the reader's account offers, for
    // the logo menu here and in _MenuBar (Identity/AccountMenu).
    var accountState = await AccountMenu.StateAsync(Context);
    ViewData["AccountMenu"] = accountState;
    // The super-user's server tools: Terminal, Files and the Editor mount
    // /wwwroot, ~ and /etc from the server and the terminal gains ssh, as on
    // the edit origin (Architecture/unified-identity-design.md).
    string? serverToolsName = accountState.ServerTools ? accountState.HomeName : null;
    bool mdFlag = ViewData["IsMarkdown"] as bool? ?? false;
    string? contentFormat = ViewData["ContentFormat"] as string;
    bool hasMermaid = ViewData["HasMermaid"] as bool? ?? false;
    bool isDesktop = ViewData["Desktop"] as bool? ?? false;
    // ?frame renders the page bare, for hosting inside a desktop window.
    bool isFrame = Context.Request.Query.ContainsKey("frame");
    bool isMarkdown = (contentFormat?.Equals("markdown", System.StringComparison.OrdinalIgnoreCase) ?? false) || mdFlag;
    if (!isMarkdown && (ViewData["HasCodeBlocks"] as bool? ?? false)) { isMarkdown = true; }
    // The desktop loads articles into windows, so it always needs the
    // highlighting assets.
    bool needsHighlight = isMarkdown || isDesktop;
}
@functions {
    // A page of this site, which the window view can open as a window.
    private static bool IsSitePage(NavNode n) =>
        !n.External && !string.IsNullOrEmpty(n.Slug) && n.Url == $"/page/{n.Slug}";

    // A page's icon as its window shows it in the taskbar (_Window's
    // WindowIcon): the navigation's icon for that page, or none.
    private string? PinIcon(string slug)
    {
        string? Find(NavNode n)
        {
            if (n.Url == $"/page/{slug}" && !string.IsNullOrEmpty(n.Icon)) { return n.Icon; }
            foreach (var c in n.Nav ?? Array.Empty<NavNode>()) { if (Find(c) is { } i) { return i; } }
            return null;
        }
        return Find(PaletteNav.GetRoot());
    }
}
@{
    void RenderMenuItem(NavNode item)
    {
        bool page = IsSitePage(item);
        string href = page && (ViewData["Desktop"] as bool? ?? false) ? $"/?open={item.Slug}&top={item.Slug}" : (item.Url ?? "/");
        <div class="md-row"><a class="md-item site-menu-item" href="@href" title="@item.Description"
            @(page && (ViewData["Desktop"] as bool? ?? false) ? Html.Raw($"data-win-open=\"{item.Slug}\"") : null)
            @(item.External ? Html.Raw("target=\"_blank\" rel=\"noopener\"") : null)>@if (!string.IsNullOrEmpty(item.Icon)) {<img class="site-menu-icon" src="@item.Icon" alt="" />} else {<span class="site-menu-icon" aria-hidden="true"></span>}@(item.Title ?? item.Slug)</a></div>
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    @if (serverToolsName is not null)
    {
        @* js/sitefs.js mounts the server's roots from this API, and the
           terminal's ssh and ssh-key come from the server; the name goes in
           an SSH key's comment. A change asks for a passkey tap through
           window.pcAdmin.confirm, which js/accounts.js supplies here. *@
        <meta name="pc-fs-mount" content="/api/admin/fs" />
        <meta name="pc-ssh-commands" content="/admin/ssh/ssh-command.js" />
        <meta name="pc-admin-name" content="@serverToolsName" />
    }
    <title>@ViewData["Title"]</title>

    @* Every PUDL asset is version-stamped: a pinned-dist upgrade must
       reach every browser at once, or a stale script meets fresh markup. *@
    <script src="~/pudl/pudl-theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/pudl/pudl.css" asp-append-version="true" />
    @if (isDesktop)
    {
        <link rel="stylesheet" href="~/pudl/pudl-windows.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/pudl-site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/window-bar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/accessibility.css" asp-append-version="true" />
    @if (accountState.Enabled)
    {
        @* The sign-in dialogs open over any page (js/accounts.js). *@
        <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    }
    <link rel="alternate" type="application/rss+xml" title="RSS Feed for @ViewData["Title"]" href="/rss">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    @RenderSection("Meta", required: false)
    @RenderSection("Links", required: false)
    @RenderSection("Style", required: false)
    @RenderSection("HeadScripts", required: false)
    <link rel="manifest" href="/site.webmanifest">

    @{
        bool hasAudio = ViewData["HasAudio"] as bool? ?? false;
    }
    @if (hasAudio)
    {
        <link rel="stylesheet" href="/css/accessible-audio-player.css" />
        <script src="/js/accessible-audio-player.js" defer></script>
    }

    @Html.RenderStaticFile("/content/head-section.html", FileReaderService)
    @if (needsHighlight)
    {
        @* Highlighted code takes PUDL's syntax tokens (0.26.0), so it
           follows the site's theme switch as well as the system's. *@
        <link rel="stylesheet" href="~/pudl/pudl-hljs.css" asp-append-version="true" />
        <script src="/highlightjs/highlight.min.js"></script>
        @if (hasMermaid || isDesktop)
        {
            <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
        }
    }
</head>
<body class="@(isDesktop ? "desktop" : null)">
    @if (!isFrame)
    {
    <header class="site-header">
        @Html.RenderStaticFile("/content/header-section.html", FileReaderService)
        <div class="topbar">
            @* The menu bar (PUDL 0.38.0, Architecture/menu-bar-design.md
               and site-menu-design.md): the host menu is the hidden list in
               _MenuBar.cshtml, from sitenav.xfer's menu. What shows before
               PUDL's script has built the bar, and without script, is the
               logo's button, as the Apple menu is, holding the links of the
               logo's title in their order: a link is a row, with its icon
               when it has one, and a heading labels the rows under it. A
               page of this site opens as a window in the window view. The
               title's commands need script, so they are left out here. *@
            @{
                var logoTitle = (PaletteNav.GetRoot().Menu ?? Array.Empty<NavNode>()).FirstOrDefault();
                var menuEntries = logoTitle?.Nav ?? Array.Empty<NavNode>();
            }
            <nav class="site-menubar" data-menubar aria-label="Parks Computing">
            <partial name="_MenuBar" />
            @* The pins group (PUDL 0.45.0, Architecture/pins-design.md): the
               Pins menu with the pinning command, then one link a pin, which
               js/pins.js writes from the reader's pins. The menu bar draws
               it between the site's menus and the front ones, and redraws it
               as the list changes. *@
            <ul data-menubar-pins hidden>
                <li>Pins<ul>
                    <li><button type="button" data-pin-command disabled>Pin</button></li>
                    <li>-</li>
                    @if (isDesktop)
                    {
                        <li><a href="/?open=pins&amp;top=pins" data-win-open="pins">Manage pins</a></li>
                    }
                    else
                    {
                        <li><a href="/pins">Manage pins</a></li>
                    }
                </ul></li>
            </ul>
            <div class="menu site-menu">
                <button type="button" class="brand topbar-pill menu-btn site-menu-btn" popovertarget="site-menu" aria-label="Parks Computing menu">
                    <img src="~/favicon-32x32.png" alt="" /> <span class="site-menu-name">Parks Computing</span>
                </button>
                <nav class="menu-panel site-menu-panel" id="site-menu" popover aria-label="Parks Computing">
                    @if (menuEntries.Length == 0)
                    {
                        <div class="md-row"><a class="md-item site-menu-item" href="/"><span class="site-menu-icon" aria-hidden="true"></span>Home</a></div>
                    }
                    @foreach (var entry in menuEntries)
                    {
                        if (entry.Heading != null)
                        {
                            <div class="md-section-label">@entry.Heading</div>
                            foreach (var item in (entry.Nav ?? Array.Empty<NavNode>()).Where(n => n.Command == null && n.From == null && !n.Separator && n.Nav is not { Length: > 0 })) { RenderMenuItem(item); }
                        }
                        else if (entry.Command == null && entry.From == null && !entry.Separator && entry.Nav is not { Length: > 0 }) { RenderMenuItem(entry); }
                    }
                    @if (accountState.Enabled)
                    {
                        <hr class="menu-sep" />
                    }
                    @foreach (var accountEntry in ParksComputing.Engine.Identity.AccountMenu.Entries(accountState, isDesktop))
                    {
                        if (accountEntry.Kind == MenuEntryKind.Heading)
                        {
                            <div class="md-section-label">@accountEntry.Label</div>
                            foreach (var accountItem in accountEntry.Entries ?? Array.Empty<MenuEntry>())
                            {
                                <div class="md-row">@Html.Raw(accountItem.Element!.Open("md-item site-menu-item"))<span class="site-menu-icon" aria-hidden="true"></span>@accountItem.Label@Html.Raw(accountItem.Element.Close())</div>
                            }
                        }
                        else
                        {
                            <div class="md-row">@Html.Raw(accountEntry.Element!.Open("md-item site-menu-item"))<span class="site-menu-icon" aria-hidden="true"></span>@accountEntry.Label@Html.Raw(accountEntry.Element.Close())</div>
                        }
                    }
                </nav>
            </div>
            </nav>
            @* The view switcher: one segmented control at the far right,
               after a rule. Each side is a link, because each view is a URL;
               ?view=window bypasses a classic default-view choice. The window
               view's dock of open windows is not here but at the foot of its
               window area (Pages/Desktop.cshtml). *@
            <span class="topbar-rule" aria-hidden="true"></span>
            @* data-seg-menu: on a phone PUDL folds the switcher into a
               pop-up button labelled with the current view (0.36.0). *@
            <nav class="seg view-seg" aria-label="View" data-seg-menu>
                <a href="/?view=window" aria-current="@(isDesktop ? "true" : null)"><span class="glyph" style="--glyph: var(--pc-glyph-windowed)" aria-hidden="true"></span>Windowed</a>
                <a href="/home" aria-current="@(isDesktop ? null : "true")"><span class="glyph" style="--glyph: var(--pc-glyph-classic)" aria-hidden="true"></span>Classic</a>
            </nav>
            @* The account, at the far right where a site's account usually
               is: Sign in when nobody is, and otherwise the reader's picture,
               which opens their account, as a window in the window view.
               Both are raised pills, because both are pressed. *@
            @if (accountState.SignedIn)
            {
                var accountLabel = "Your account" + (accountState.Name is null ? "" : " (" + accountState.Name + ")");
                <a class="topbar-pill account-pill" href="@(isDesktop ? "/?open=account&top=account" : "/account")"
                   @(isDesktop ? Html.Raw("data-win-open=\"account\"") : null) aria-label="@accountLabel" title="@accountLabel">
                    @ParksComputing.Engine.Identity.AccountMenu.Avatar(accountState.AvatarUrl, "account-avatar")
                </a>
            }
            else if (accountState.Enabled)
            {
                <a class="topbar-pill account-pill account-signin" href="/account/signin" data-account-dialog>Sign in</a>
            }
        </div>
        @* The classic view's categories, on a band of section tabs just below
           the top bar, at every width (Pages/Components/Nav). *@
        @if (!isDesktop)
        {
            @await Component.InvokeAsync("Nav")
        }
    </header>
    }

    @if (isDesktop)
    {
        @RenderBody()
    }
    else
    {
        <div class="site-main @(isFrame ? "site-main-framed" : null)">
            @if (!isFrame)
            {
                @Html.RenderStaticFile("/content/main-section.html", FileReaderService)
            }

            <div class="content-body" role="main" id="main-content" tabindex="-1">
                @RenderBody()
                @if (ViewData["PageId"] is string pageIdLocal && ViewData["Draft"] is null)
                {
                    <partial name="_DiscussionMount" model="pageIdLocal" />
                }
            </div>
        </div>

        if (!isFrame)
        {
        <footer class="site-footer">
            @Html.RenderStaticFile("/content/footer-section.html", FileReaderService)
        </footer>
        }
    }

    @* The image lightbox, for both views: server-rendered per PUDL, filled
       and shown by lightbox.js. The stage scrolls when an image is zoomed
       to its full size. *@
    <dialog class="lightbox" id="image-lightbox" aria-label="Image viewer">
        <div class="lightbox-stage"><img class="lightbox-img" src="" alt=""></div>
        <div class="lightbox-bar">
            <span class="lightbox-caption"></span>
            <span class="lightbox-counter num"></span>
        </div>
        <button type="button" class="lightbox-btn lightbox-close" aria-label="Close" title="Close (Esc)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
        <button type="button" class="lightbox-btn lightbox-prev" aria-label="Previous image" title="Previous (Left arrow)" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" class="lightbox-btn lightbox-next" aria-label="Next image" title="Next (Right arrow)" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
    </dialog>

    @* Settings is an applet now (js/settings.js), in the site menu and the
       Applets section, where the dialog that stood here used to be. *@

    @if (!isFrame)
    {
        @* The go palette, PUDL 0.17.0: a buttonless menu panel summoned by
           '/', opening top-centre with focus in its filter. Typing narrows
           the rows; Enter follows the remaining row, or, with none left,
           submits the form to /go, which redirects by slug, so unlisted
           pages stay reachable. *@
        <nav class="menu-panel go-palette" popover data-menu-key="/" aria-label="Go to page">
            <form action="/go" method="get" role="search">
                <input class="md-filter" type="search" name="slug" placeholder="Go to&#8230;" aria-label="Go to page" autocomplete="off" spellcheck="false" />
                @if (!isDesktop)
                {
                    <input type="hidden" name="nav" value="1" />
                }
                else
                {
                    @* The desktop's state rides along, so /go adds the new
                       window to what is open instead of replacing it. The
                       fields are server-rendered as of this page load and
                       desktop.js refreshes them when the form submits. *@
                    foreach (var stateParam in Context.Request.Query)
                    {
                        if (stateParam.Key is "slug" or "nav" or "view") { continue; }
                        foreach (var stateValue in stateParam.Value)
                        {
                            <input type="hidden" data-go-state name="@stateParam.Key" value="@stateValue" />
                        }
                    }
                }
            </form>
            @{
                var paletteRoot = PaletteNav.GetRoot();
                string PaletteHref(string slug) => isDesktop ? $"/?open={slug}&top={slug}" : $"/page/{slug}";
            }
            @* Every section, Articles among them, in sitenav.xfer's order. *@
            @foreach (var paletteSection in paletteRoot.Nav ?? Array.Empty<NavNode>())
            {
                if (paletteSection.Nav is not { Length: > 0 }) { continue; }
                <div class="md-section-label">@paletteSection.Title</div>
                foreach (var item in paletteSection.Nav)
                {
                    if (string.IsNullOrEmpty(item.Slug)) { continue; }
                    if (item.External || (item.Url?.StartsWith("http", StringComparison.OrdinalIgnoreCase) ?? false))
                    {
                        <div class="md-row"><a class="md-item" href="@item.Url" target="_blank" rel="noopener">@(item.Title ?? item.Slug)</a></div>
                    }
                    else
                    {
                        <div class="md-row"><a class="md-item" href="@PaletteHref(item.Slug)"
                            @(isDesktop ? Html.Raw($"data-win-open=\"{item.Slug}\"") : null)>@(item.Title ?? item.Slug)</a></div>
                    }
                }
            }
            @{
                var paletteLeaves = (paletteRoot.Nav ?? Array.Empty<NavNode>())
                    .Where(n => n.Nav is not { Length: > 0 } && !string.IsNullOrEmpty(n.Slug)).ToList();
            }
            @if (paletteLeaves.Count > 0)
            {
                <div class="md-section-label">Pages</div>
                foreach (var leaf in paletteLeaves)
                {
                    if (!string.IsNullOrEmpty(leaf.Url) && leaf.Url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="md-row"><a class="md-item" href="@leaf.Url" target="_blank" rel="noopener">@(leaf.Title ?? leaf.Slug)</a></div>
                    }
                    else
                    {
                        <div class="md-row"><a class="md-item" href="@PaletteHref(leaf.Slug!)"
                            @(isDesktop ? Html.Raw($"data-win-open=\"{leaf.Slug}\"") : null)>@(leaf.Title ?? leaf.Slug)</a></div>
                    }
                }
            }
        </nav>
    }

    @if (accountState.SignedIn)
    {
        @* Sign out is a POST, so the logo menu's Sign out submits this form.
           The reader comes back to the page they were on. *@
        <form id="@ParksComputing.Engine.Identity.AccountMenu.SignOutForm" method="post" action="/account/signout" hidden>
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
        </form>
    }
    @if (accountState.Enabled)
    {
        @* Sign in and Create account open over the page, and passkeys work
           anywhere (js/accounts.js). The token lets a script's request pass
           the antiforgery check. *@
        <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
        <script src="~/js/accounts.js" defer asp-append-version="true"></script>
    }
    @{
        // The reader's pins, as data for js/pins.js: an account's from the
        // database, or none, meaning the browser keeps them. And on a page of
        // the classic view, what pinning this page would pin.
        System.Collections.Generic.IReadOnlyList<ParksComputing.Engine.Identity.Pin>? accountPins = accountState.SignedIn
            ? await PinStore.GetAsync(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value) : null;
        object? currentPin = null;
        if (!isDesktop && !isFrame)
        {
            if (ViewData["Book"] is BookService.Book pinBook)
            {
                var pinChapter = ViewData["BookChapter"] as string ?? "";
                var pinChapterTitle = pinChapter.Length > 0 ? pinBook.Find(pinChapter)?.Title : null;
                currentPin = new { key = pinBook.Slug, chapter = pinChapter.Length > 0 ? pinChapter : null,
                    title = pinBook.Root.Title + (pinChapterTitle is null ? "" : " · " + pinChapterTitle), icon = PinIcon(pinBook.Slug) };
            }
            else if (ViewData["PageId"] is string pinSlug && !pinSlug.Contains('/'))
            {
                // The title its window and taskbar show, from the same service
                // the window uses, so a page pinned here reads as it does pinned
                // from its window.
                currentPin = new { key = pinSlug, chapter = (string?)null,
                    title = PinArticles.Load(pinSlug)?.Title ?? System.Net.WebUtility.HtmlDecode(ViewData["Title"]?.ToString() ?? pinSlug), icon = PinIcon(pinSlug) };
            }
            else if (Context.Request.Path == "/account" && accountState.Enabled)
            {
                currentPin = new { key = "account", chapter = (string?)null, title = "Your account", icon = (string?)null };
            }
        }
    }
    <script type="application/json" id="pc-pins-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        store = accountPins is null ? "local" : "account",
        pins = accountPins,
        current = currentPin
    }, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)).Replace("<", "\\u003c"))</script>
    <script src="~/js/pins.js" defer asp-append-version="true"></script>
    <script src="~/js/continuity.js" asp-append-version="true"></script>
    <script src="~/js/window-bar.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/lightbox.js" asp-append-version="true"></script>
    <script src="~/js/books.js" defer asp-append-version="true"></script>
    @if (isDesktop)
    {
        <script src="~/js/desktop.js" asp-append-version="true"></script>
        <script src="~/pudl/pudl-windows.js" defer asp-append-version="true"></script>
        <script src="~/pudl/pudl-regions.js" defer asp-append-version="true"></script>
        <script src="~/pudl/pudl-md.js" defer asp-append-version="true"></script>
    }
    @* The menu script loads everywhere since 0.17.0: the go palette is a
       key-summoned menu panel on every page. *@
    <script src="~/pudl/pudl-menu.js" defer asp-append-version="true"></script>
    <script src="~/pudl/pudl-applets.js" defer asp-append-version="true"></script>
    <script src="~/js/applets.js" defer asp-append-version="true"></script>
    @* The menu bar, after the menu, window and applet scripts it uses
       (PUDL 0.38.0), and the site's commands, which its menu names. *@
    <script src="~/pudl/pudl-menubar.js" defer asp-append-version="true"></script>
    <script src="~/js/commands.js" defer asp-append-version="true"></script>
    <script src="~/pudl/pudl-dialog.js" defer asp-append-version="true"></script>
    <script src="~/pudl/pudl-tooltip.js" defer asp-append-version="true"></script>
    @* Document tabs, trees and grids, for the Editor and Files applets,
       which can open on any page. *@
    <script src="~/pudl/pudl-tabs.js" defer asp-append-version="true"></script>
    <script src="~/pudl/pudl-tree.js" defer asp-append-version="true"></script>
    <script src="~/pudl/pudl-split.js" defer asp-append-version="true"></script>
    <script src="~/pudl/pudl-grid.js" defer asp-append-version="true"></script>
    @* Copy and Download on every code block (0.29.0); site.js hands the
       blocks over. *@
    <script src="~/pudl/pudl-code.js" defer asp-append-version="true"></script>
    @RenderSection("BodyScripts", required: false)
    @if (isMarkdown)
    {
        <script>
            (function () {
                function renderMarkdownEnhancements() {
                    document.querySelectorAll('pre > code.language-mermaid, pre > code[class*="language-mermaid"]').forEach(function (codeBlock) {
                        var pre = codeBlock.parentElement;
                        if (!pre) { return; }

                        var mermaidNode = document.createElement('div');
                        mermaidNode.className = 'mermaid';
                        mermaidNode.textContent = codeBlock.textContent || '';
                        pre.replaceWith(mermaidNode);
                    });

                    if (window.mermaid && document.querySelector('.mermaid')) {
                        window.mermaid.initialize({ startOnLoad: false });
                        window.mermaid.run({ querySelector: '.mermaid' });
                    }

                    if (window.hljs) {
                        document.querySelectorAll('pre code:not(.language-mermaid)').forEach(function (block) {
                            window.hljs.highlightElement(block);
                        });
                    }
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', renderMarkdownEnhancements);
                } else {
                    renderMarkdownEnhancements();
                }
            })();
        </script>
    }
</body>
</html>
