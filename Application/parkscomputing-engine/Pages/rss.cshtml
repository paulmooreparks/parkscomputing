@page "/rss"
@model ParksComputing.Engine.Pages.RssModel
@{
    Layout = "_Rss";
    Response.ContentType = "text/xml";
    ViewData["Title"] = "Parks Computing";
    ViewData["Link"] = "https://parkscomputing.com";
    ViewData["Description"] = Model.Description;
    ViewData["Language"] = Model.Language;
    ViewData["PubDate"] = Model.CreateDate.ToString("R");
    ViewData["LastBuildDate"] = Model.ModifiedDate.ToString("R");
}
@* The articles, the entries of the sections sitenav.xfer marks feed,
   newest first, as a feed reader expects, whatever order the site lists
   them in. *@
@if (Model.Root != null) {
@foreach (var post in ParksComputing.Engine.Pages.Services.NavService.Articles(Model.Root)
    .OrderByDescending(p => ParksComputing.Engine.Pages.Services.NavService.EffectiveDate(p) ?? DateTime.MinValue)) {
    @:<item>
        <title>@post.Title</title>
        @:<link>@post.Url</link>
        <description>@post.Excerpt</description>
    <pubDate>@(post.Date?.ToString("R") ?? DateTime.UtcNow.ToString("R"))</pubDate>
        <guid>@post.Url</guid>
    @:</item>
}
}

