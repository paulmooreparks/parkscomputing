@page "/"
@using System.Globalization;
@using System.IO;
@using ParksComputing.Engine.Pages.Models;
@model ParksComputing.Engine.Pages.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Html.Raw(Model.Title);
}

@section Meta { @if (Model.MetaElements is not null) {
@foreach (var element in @Model.MetaElements) {
    @Html.Raw(element.OuterHtml)
}}
}

@section Links { @if (Model.LinkElements is not null) {
@foreach (var element in @Model.LinkElements) {
    @Html.Raw(element.OuterHtml)
}}
}

@section Style { @if (Model.StyleElements is not null) {
@foreach (var element in @Model.StyleElements) {
    @Html.Raw(element.OuterHtml)
}}
}

@section HeadScripts { @if (Model.HeadScriptElements is not null) {
@foreach (var element in @Model.HeadScriptElements) {
    @Html.Raw(element.OuterHtml)
}}
}

<div class="main-container">
    @{
        var processedContent = Model.PageContent;

        if (processedContent != null)
        {
            // Process all RENDER_POSTS_ markers
            foreach (var key in ViewData.Keys.Where(k => k.StartsWith("RENDER_POSTS_")))
            {
                if (ViewData[key] is PostsContentModel model && processedContent.Contains(key))
                {
                    var partialName = model.Format switch
                    {
                        "links" => "_PostsLinks",
                        "excerpts" => "_PostsExcerpts",
                        _ => "_PostsPartial" // cards format (default)
                    };

                    var postsHtml = await Html.PartialAsync(partialName, model);

                    // Convert IHtmlContent to string properly
                    using var writer = new StringWriter();
                    postsHtml.WriteTo(writer, System.Text.Encodings.Web.HtmlEncoder.Default);
                    var postsString = writer.ToString();

                    processedContent = processedContent.Replace(key, postsString);
                }
            }

            // Process all RENDER_NAV_ markers
            foreach (var key in ViewData.Keys.Where(k => k.StartsWith("RENDER_NAV_")))
            {
                // Debug: Check what's in ViewData
                var debugInfo = $"Found nav marker: {key}, Value type: {ViewData[key]?.GetType().Name ?? "null"}";
                processedContent = processedContent.Replace(key, $"<!-- DEBUG: {debugInfo} --> {key}");

                if (ViewData[key] is NavContentModel navModel && processedContent.Contains(key))
                {
                    var partialName = navModel.Format switch
                    {
                        "vertical" => "_NavVertical",
                        "breadcrumb" => "_NavBreadcrumb",
                        "sidebar" => "_NavSidebar",
                        _ => "_NavHorizontal" // horizontal format (default)
                    };

                    var navHtml = await Html.PartialAsync(partialName, navModel);

                    // Convert IHtmlContent to string properly
                    using var writer = new StringWriter();
                    navHtml.WriteTo(writer, System.Text.Encodings.Web.HtmlEncoder.Default);
                    var navString = writer.ToString();

                    processedContent = processedContent.Replace(key, navString);
                }
            }

            // Legacy support for old RENDER_POSTS_HERE marker
            if (processedContent.Contains("RENDER_POSTS_HERE") && Model.Root?.Posts != null)
            {
                var legacyModel = new PostsContentModel { NavNode = Model.Root };
                var postsHtml = await Html.PartialAsync("_PostsPartial", legacyModel);

                using var writer = new StringWriter();
                postsHtml.WriteTo(writer, System.Text.Encodings.Web.HtmlEncoder.Default);
                var postsString = writer.ToString();

                processedContent = processedContent.Replace("RENDER_POSTS_HERE", postsString);
            }
        }
    }
    @Html.Raw(processedContent)
</div>
