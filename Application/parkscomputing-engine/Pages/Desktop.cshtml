@page "/"
@using ParksComputing.Engine.Pages.Services
@model ParksComputing.Engine.Pages.DesktopModel
@inject ParksComputing.Engine.Identity.AccountMenu LauncherAccountMenu
@inject Microsoft.Extensions.Configuration.IConfiguration LauncherConfiguration
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Root.SiteName();
    ViewData["Desktop"] = true;
    ViewData["Launcher"] = true;
    var launcherAccount = await LauncherAccountMenu.StateAsync(Model.HttpContext);
    var catalogKeys = (Model.Root.Nav ?? Array.Empty<NavNode>())
        .SelectMany(n => n.Nav is { Length: > 0 } ? n.Nav : new[] { n }).Select(n => n.Slug).ToHashSet();
    var extraTools = SiteMenu.Build(Model.Root, true, LauncherConfiguration["Site:Stage"], launcherAccount.Roles)
        .Where(t => t.Id == "applets").SelectMany(t => t.Entries)
        .Where(e => e.Kind == MenuEntryKind.Item && e.Element is not null
            && e.Element.Attributes.Any(a => a.Key == "data-win-open" && !string.IsNullOrEmpty(a.Value))
            && !catalogKeys.Contains(e.Element.Attributes.FirstOrDefault(a => a.Key == "data-win-open").Value));
    // The dock and the window-wide actions stand at the foot of the window
    // area (Pages/Shared/_WindowBar.cshtml), rendered as the address has them.
    var windowBar = new ParksComputing.Engine.Pages.Models.WindowBarModel(
        AnyShowing: Model.Windows.Any(w => !w.Minimized && w.Parent is null),
        AnyMinimized: Model.Windows.Any(w => w.Minimized && w.Parent is null),
        AnyOpen: Model.Windows.Count > 0,
        MinimizeAllUrl: Model.MinimizeAllUrl, RestoreAllUrl: Model.RestoreAllUrl, CloseAllUrl: Model.ListOnlyUrl);
}

@functions {
    private static bool IsInternal(NavNode node) =>
        !node.External && string.IsNullOrEmpty(node.Target) && !string.IsNullOrEmpty(node.Slug);
}

@{
    void RenderRow(NavNode node, string category)
    {
        var key = IsInternal(node) ? node.Slug : node.Frame ? ArticleContentService.ExternalKey(node) : null;
        var destination = IsInternal(node) ? ParksComputing.Engine.Pages.Models.WindowViewModel.DestinationFor(key!) : null;
        var date = NavService.EffectiveDate(node)?.ToString("d MMMM yyyy");
        <li class="md-row" data-start-item data-start-category="@category" data-win-pin-target="@destination"
            data-win-destination-provider="@(destination is not null ? "content" : null)"
            data-start-keywords="@string.Join(" ", node.Tags ?? Array.Empty<string>())"
            data-catalog-tags="@System.Text.Json.JsonSerializer.Serialize(node.Tags ?? Array.Empty<string>())"
            hidden="@(!Model.ShowSection(category) || !Model.RowMatches(node))">
            <a class="md-item start-item" href="@(node.Url ?? $"/page/{node.Slug}")"
               data-win-open="@key" target="@(node.External ? "_blank" : null)" rel="@(node.External ? "noopener" : null)">
                @if (node.Icon is not null) { <img class="catalog-icon" src="@node.Icon" alt="" /> }
                else { <span class="glyph" style="--glyph: var(--glyph-file)" aria-hidden="true"></span> }
                <span class="start-copy"><span class="start-name">@node.Title</span>
                    @if (date is not null) { <span class="md-meta">@date</span> }
                    @if (node.Description is not null) { <span class="md-meta">@node.Description</span> }
                </span>
            </a>
            @if (destination is not null) { <button type="button" data-row-actions aria-label="Actions for @node.Title"></button> }
        </li>
    }
}

<div class="split catalog-workspace" id="catalog-workspace">
    <div class="split-pane catalog-slot" id="catalog-slot">
        <section class="menu-panel start-menu site-launcher" id="site-launcher" data-start data-start-side="left" aria-labelledby="catalog-title">
            <header class="popover-head start-header">
                <h2 class="visually-hidden" id="catalog-title">@Model.Root.SiteName()</h2>
                <nav class="catalog-actions" aria-label="Launcher actions">
                    <a class="btn btn-sm" href="/page/settings" data-win-open="settings" data-launcher-activate><span class="glyph" style="--glyph:var(--glyph-gear)" aria-hidden="true"></span>Settings</a>
                    @if (launcherAccount.Enabled)
                    {
                        if (launcherAccount.SignedIn)
                        {
                            <a class="btn btn-sm" href="/account" data-win-open="account" data-launcher-activate><span class="glyph" style="--glyph:var(--glyph-account)" aria-hidden="true"></span>Your account</a>
                        }
                        else
                        {
                            <a class="btn btn-sm" href="/account/signin" data-account-dialog data-launcher-activate><span class="glyph" style="--glyph:var(--glyph-account)" aria-hidden="true"></span>Sign in</a>
                        }
                    }
                </nav>
                <button class="icon-btn" type="button" data-launcher-pin aria-label="Keep launcher open" title="Pin launcher" aria-pressed="true"><span class="glyph" style="--glyph:var(--glyph-pin)" aria-hidden="true"></span></button>
                <button class="icon-btn popover-close" type="button" data-launcher-close aria-label="Close launcher"></button>
            </header>
            <div class="start-search">
                <form class="md-filter-group start-search-form" method="get" action="/" role="search">
                    @foreach (var kv in Model.FilterFormParams) { <input type="hidden" name="@kv.Key" value="@kv.Value" /> }
                    <input class="md-filter" data-start-query type="search" name="q" value="@Model.Q" placeholder="Find articles and applets…" aria-label="Search the catalog" autocomplete="off" />
                    <button class="icon-btn md-filter-go" type="submit" aria-label="Open first result"></button>
                </form>
                <a class="btn btn-sm" href="@Model.ClearFiltersUrl" data-catalog-clear><span class="glyph" style="--glyph:var(--glyph-close)" aria-hidden="true"></span>Clear</a>
            </div>
            <div class="catalog-filters">
                <div class="menu">
                    <button class="btn btn-sm menu-btn" type="button" popovertarget="tag-filter-menu">Tags</button>
                    <nav class="menu-panel" id="tag-filter-menu" popover aria-label="Filter by tag" data-catalog-tag-menu>
                        <form method="get" action="/">
                        @foreach (var kv in Model.FilterFormParams.Where(kv => kv.Key != "tag")) { <input type="hidden" name="@kv.Key" value="@kv.Value" /> }
                        @if (Model.Q is not null) { <input type="hidden" name="q" value="@Model.Q" /> }
                        @foreach (var tag in Model.AllTags)
                        {
                            <label class="check menu-check"><input type="checkbox" name="tag" value="@tag" checked="@Model.SelectedTags.Contains(tag)"> @tag</label>
                        }
                        <noscript><button class="btn btn-sm" type="submit">Apply tags</button></noscript>
                        </form>
                    </nav>
                </div>
                <div class="catalog-chips" data-catalog-chips>
                    @foreach (var tag in Model.SelectedTags)
                    {
                        <span class="filter-chip">@tag <a class="filter-chip-x" href="@Model.RemoveTagUrl(tag)" data-remove-tag="@tag" aria-label="Remove the @tag tag filter"></a></span>
                    }
                </div>
            </div>
            <div class="split start-content">
                <nav class="split-pane start-categories" data-start-categories aria-label="Catalog categories">
                    <ul class="row-list start-category-list">
                        <li class="md-row"><a class="md-item start-category" href="@Model.CategoryUrl(null)" data-start-category-key=""><span data-start-label>All</span><span class="start-category-count" data-start-category-count></span></a></li>
                        @foreach (var (slug, title) in Model.Categories)
                        {
                            <li class="md-row"><a class="md-item start-category" href="@Model.CategoryUrl(slug)" data-start-category-key="@slug"><span data-start-label>@title</span><span class="start-category-count" data-start-category-count></span></a></li>
                        }
                    </ul>
                </nav>
                <div class="split-handle" aria-label="Resize catalog categories" data-split-min="90" data-split-max="45%"></div>
                <div class="split-pane start-items-pane">
                    <div class="start-heading"><h3 data-start-heading>All</h3><span class="start-count-summary"><span data-start-count></span> items</span></div>
                    <ul class="row-list start-items site-list" data-start-items>
                        @foreach (var navSection in Model.Root.Nav ?? Array.Empty<NavNode>())
                        {
                            foreach (var node in navSection.Nav is { Length: > 0 } ? navSection.Nav : new[] { navSection }) { RenderRow(node, navSection.Slug ?? ""); }
                        }
                        @foreach (var tool in extraTools)
                        {
                            <li class="md-row" data-start-item data-start-category="applets" data-catalog-tags="[]"
                                hidden="@(!Model.ShowSection("applets") || !Model.RowMatches(new NavNode { Title = tool.Label }))">
                                @Html.Raw(tool.Element!.Open("md-item start-item"))<span class="glyph" style="--glyph:var(--glyph-app)" aria-hidden="true"></span><span class="start-copy">@tool.Label</span>@Html.Raw(tool.Element.Close())
                            </li>
                        }
                    </ul>
                    <p class="catalog-empty" data-start-empty hidden>No items match. Try another category or clear the filters.</p>
                </div>
            </div>
            <footer class="popover-foot start-footer">
                <span class="catalog-key-hint">↑↓ Browse · Enter Open · Esc Close</span>
                <button class="btn btn-sm" type="button" data-launcher-size popovertarget="catalog-size"><span class="glyph" style="--glyph:var(--glyph-window)" aria-hidden="true"></span>Size</button>
            </footer>
            <div class="visually-hidden" data-start-announcement aria-live="polite"></div>
            <section class="popover" id="catalog-size" popover data-launcher-size-panel aria-labelledby="catalog-size-title">
                <header class="popover-head"><h3 id="catalog-size-title">Launcher size</h3></header>
                <div class="popover-body catalog-size-fields">
                    <label class="form-label">Width (px)<input class="form-input" type="number" min="280" max="2000" data-launcher-width /></label>
                    <label class="form-label">Height (px)<input class="form-input" type="number" min="260" max="1600" data-launcher-height /></label>
                    <button class="btn btn-sm" type="button" data-launcher-reset>Reset size</button>
                </div>
            </section>
        </section>
    </div>
    <div class="split-handle catalog-divider" aria-label="Resize launcher" data-split-min="300" data-split-max="75%"></div>
    <div class="split-pane reader-stage catalog-reader" tabindex="0">
        <main class="win-host">
            <div class="reader-empty">
                @if (Model.WelcomeHtml is not null)
                {
                    <div class="card welcome-card">@Html.Raw(Model.WelcomeHtml)</div>
                }
            </div>
            <div class="win-layer" data-win-layer data-win-taskbar-reorder data-win-src="/window/{key}">
                @foreach (var win in Model.Windows) { <partial name="_Window" model="win" /> }
            </div>
        </main>
    </div>
</div>
<partial name="_WindowBar" model="windowBar" />
