@page "/"
@using ParksComputing.Engine.Pages.Services
@model ParksComputing.Engine.Pages.DesktopModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Parks Computing";
    ViewData["Desktop"] = true;
    // The dock and the window-wide actions stand at the foot of the window
    // area (Pages/Shared/_WindowBar.cshtml), rendered as the address has them.
    var windowBar = new ParksComputing.Engine.Pages.Models.WindowBarModel(
        AnyShowing: Model.Windows.Any(w => !w.Minimized && w.Parent is null),
        AnyMinimized: Model.Windows.Any(w => w.Minimized && w.Parent is null),
        AnyOpen: Model.Windows.Count > 0,
        MinimizeAllUrl: Model.MinimizeAllUrl, RestoreAllUrl: Model.RestoreAllUrl, CloseAllUrl: Model.ListOnlyUrl);
}

@functions {
    private static bool IsInternal(NavNode node) =>
        !node.External && string.IsNullOrEmpty(node.Target) && !string.IsNullOrEmpty(node.Slug);
}

@{
    void RenderRow(NavNode node)
    {
        @* Under the title: the date and the description, each when there is
           one, as two muted lines. *@
        var date = NavService.EffectiveDate(node)?.ToString("d MMMM yyyy");
        var description = node.Description;
        if (IsInternal(node))
        {
            var key = node.Slug!;
            var active = key == Model.TopKey;
            @* data-tags lets the live filter match what the row does not show. *@
            <div class="md-row @(active ? "active" : null)" id="row-@key"
                 @(node.Tags is { Length: > 0 } ? Html.Raw($"data-tags=\"{System.Net.WebUtility.HtmlEncode(string.Join(" ", node.Tags).ToLowerInvariant())}\"") : null)>
                <a class="md-item" href="@(node.Url ?? $"/page/{key}")" data-win-open="@key"
                   title="@node.Description" aria-current="@(active ? "true" : null)">
                    @node.Title
                    @if (!string.IsNullOrEmpty(date))
                    {
                        <span class="md-meta">@date</span>
                    }
                    @if (!string.IsNullOrEmpty(description))
                    {
                        <span class="md-meta md-desc">@description</span>
                    }
                </a>
            </div>
            @* The same child rows the script renders, so a URL with child
               windows open lists them without script. The script replaces
               rows carrying data-win-child as the state changes. *@
            if (Model.ChildrenOf.TryGetValue(key, out var children))
            {
                foreach (var child in children)
                {
                    <div class="md-row md-row-child @(child.Key == Model.TopKey ? "active" : null)" data-win-child="@child.Key">
                        <a class="md-item" href="?open=@string.Join(",", Model.OpenKeys)&top=@child.Key"
                           aria-current="@(child.Key == Model.TopKey ? "true" : null)">@child.Title</a>
                    </div>
                }
            }
        }
        else
        {
            @* An external marked frame ~true opens as a framed window; the
               href stays the destination for no-script and classic. *@
            var extKey = node.Frame ? ParksComputing.Engine.Pages.Services.ArticleContentService.ExternalKey(node) : null;
            <div class="md-row">
                <a class="md-item" href="@node.Url" target="_blank" rel="noopener" title="@node.Description"
                   @(extKey is null ? null : Html.Raw($"data-win-open=\"{extKey}\""))>
                    @node.Title <span class="md-meta">@(node.Description ?? node.Url)</span>
                </a>
            </div>
        }
    }
}

<div class="md-layout" data-md-pane="@(Model.AnyVisible ? "detail" : "list")">
    @* A stored sidebar width applies before the first paint, per PUDL's
       0.14.0 pattern; a later script would let the default width flash. *@
    <script>
        (function (layout) {
            try {
                var w = localStorage.getItem('pc-sidebar-w');
                if (w) { layout.style.setProperty('--md-sidebar-w', w); }
                layout.addEventListener('pudl:md-resize', function (e) {
                    if (e.detail.reset) { localStorage.removeItem('pc-sidebar-w'); }
                    else { localStorage.setItem('pc-sidebar-w', e.detail.width + 'px'); }
                });
            } catch (e) { /* the default width serves */ }
        })(document.currentScript.parentElement);
    </script>
    @* The list's bar (Paul, 2026-10-01): the filter controls at the left,
       over the list they filter, then a rule, then the filter chips. The
       category tabs that stood above it are gone; the Categories menu does
       their job. It is PUDL's list toolbar, which a phone hides with the
       list while a window shows. The filter form and the chips are separate
       regions, each swapped in by pudl-regions.js. *@
    <div class="md-toolbar site-listbar">
        <form class="md-filter-group" data-region="filter" method="get" action="/" role="search">
            @foreach (var kv in Model.FilterFormParams)
            {
                <input type="hidden" name="@kv.Key" value="@kv.Value" />
            }
            <input class="md-filter" type="search" name="q" value="@Model.Q"
                   placeholder="Filter the list…" aria-label="Filter the list" />
            <button class="icon-btn md-filter-go" type="submit" aria-label="Apply the filter" title="Apply the filter"></button>
        </form>
        @* Multi-select menus, after the Andoneer board's workstream filter:
           the popover stays open across checking (light dismiss closes it
           on an outside click), each change submits the filter form, and
           desktop.js re-syncs the boxes from the URL after every swap. *@
        <div class="menu">
            <button class="btn btn-sm menu-btn" type="button" popovertarget="cat-filter-menu">Categories</button>
            <nav class="menu-panel" id="cat-filter-menu" popover aria-label="Filter by category" data-filter-menu="cat">
                @foreach (var (slug, title) in Model.Categories)
                {
                    <label class="check menu-check"><input type="checkbox" value="@slug"
                           @(Model.SelectedCats.Contains(slug) ? Html.Raw("checked") : null)> @title</label>
                }
            </nav>
        </div>
        <div class="menu">
            <button class="btn btn-sm menu-btn" type="button" popovertarget="tag-filter-menu">Tags</button>
            <nav class="menu-panel" id="tag-filter-menu" popover aria-label="Filter by tag" data-filter-menu="tag">
                @foreach (var tag in Model.AllTags)
                {
                    <label class="check menu-check"><input type="checkbox" value="@tag"
                           @(Model.SelectedTags.Contains(tag) ? Html.Raw("checked") : null)> @tag</label>
                }
            </nav>
        </div>
        <span class="md-toolbar-sep" aria-hidden="true"></span>
        @* Always present, so region swaps always find their counterpart. It
           starts with the button that clears every filter (Paul, 2026-10-01),
           fixed at the left of the chips so it never moves as they come and
           go, dimmed when there is nothing to clear. It keeps the windows.
           Its address is the unfiltered list, so it works without script. *@
        <div class="site-chips" data-region="chips">
        <a class="icon-btn filter-clear @(Model.ActiveFilterCount == 0 ? "is-disabled" : null)"
           href="@Model.ClearFiltersUrl"
           @(Model.ActiveFilterCount == 0 ? Html.Raw("aria-disabled=\"true\" tabindex=\"-1\"") : null)
           aria-label="Clear all filters" title="Clear all filters"><svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="8" cy="8" r="5.5"/><line x1="4.2" y1="11.8" x2="11.8" y2="4.2"/></svg></a>
        @foreach (var cat in Model.SelectedCats)
        {
            <span class="filter-chip"><span class="filter-chip-kind">category</span> @Model.CatTitleOf(cat) <a class="filter-chip-x" href="@Model.RemoveCatUrl(cat)" aria-label="Remove the @Model.CatTitleOf(cat) category filter"></a></span>
        }
        @foreach (var tag in Model.SelectedTags)
        {
            <span class="filter-chip"><span class="filter-chip-kind">tag</span> @tag <a class="filter-chip-x" href="@Model.RemoveTagUrl(tag)" aria-label="Remove the @tag tag filter"></a></span>
        }
        @if (Model.Q is not null)
        {
            <span class="filter-chip"><span class="filter-chip-kind">filter</span> @Model.Q <a class="filter-chip-x" href="@Model.RemoveQUrl" aria-label="Remove the text filter"></a></span>
        }
        </div>
    </div>
    <div class="md-body">
        <nav class="md-sidebar" data-region="list" aria-label="Articles and pages">
            @* Every section in sitenav.xfer's order, Articles among them,
               each row in the order the file gives. *@
            @if (Model.Root.Nav is not null)
            {
                foreach (var navSection in Model.Root.Nav)
                {
                    if (!Model.ShowSection(navSection.Slug)) { continue; }
                    var rows = navSection.Nav is { Length: > 0 }
                        ? navSection.Nav.Where(Model.RowMatches).ToList()
                        : (Model.RowMatches(navSection) ? new List<NavNode> { navSection } : new List<NavNode>());
                    if (rows.Count == 0) { continue; }
                    <div class="md-section-label">@navSection.Title</div>
                    foreach (var row in rows)
                    {
                        RenderRow(row);
                    }
                }
            }
        </nav>
        <div class="md-resize" role="separator" aria-orientation="vertical" aria-label="Resize the list"></div>
        @* tabindex: the pane is a tab stop so the keyboard can scroll it
           (PUDL 0.22.1). *@
        <div class="md-detail reader-stage" tabindex="0">
            <div class="reader-col">
                <a class="md-back" href="/" data-win-back>Articles</a>
                <main class="win-host">
                    <div class="reader-empty">
                        @if (Model.WelcomeHtml is not null)
                        {
                            @* Copy lives at content/desktop-welcome.md. *@
                            <div class="card welcome-card">
                                @Html.Raw(Model.WelcomeHtml)
                            </div>
                        }
                    </div>
                    <div class="win-layer" data-win-layer data-win-src="/window/{key}">
                        @foreach (var win in Model.Windows)
                        {
                            <partial name="_Window" model="win" />
                        }
                    </div>
                </main>
                <partial name="_WindowBar" model="windowBar" />
            </div>
        </div>
    </div>
</div>
