@page
@model ParksComputing.Engine.Pages.Account.LinkModel
@{ ViewData["Title"] = "Confirm sign-in | Parks Computing"; }
@* The page an emailed link opens. Opening it spends nothing, so a mail
   scanner that follows the link cannot use it up; the button does. *@
<div class="account-page">
@if (Model.Valid)
{
    <h1>@(Model.Purpose == ParksComputing.Engine.Identity.AccountLinkPurpose.VerifyEmail ? "Confirm your email address" : "Sign in")</h1>
    <p>Press the button to finish signing in to Parks Computing in this browser.</p>
    <form method="post" asp-antiforgery="true">
        <input type="hidden" name="Uid" value="@Model.Uid" />
        <input type="hidden" name="Token" value="@Model.Token" />
        <input type="hidden" name="Purpose" value="@Model.Purpose" />
        <input type="hidden" name="Return" value="@Model.Return" />
        <div class="account-actions"><button class="btn btn-primary" type="submit">Sign in</button></div>
    </form>
}
else
{
    <h1>This link has already been used or has expired</h1>
    <p>Each link works once, within 15 minutes, and asking for a new one replaces the old.</p>
    <p><a class="btn" href="/account/signin" data-account-dialog>Ask for a new link…</a></p>
}
</div>
