@page "/admin/stats"
@model ParksComputing.Engine.Pages.SiteAdmin.StatsModel
@{
    ViewData["Title"] = "Visits";
}
@* The automated readers the site counts, drawn on the server: totals, a
   bar for each day, and tables by agent and by page. The range is in the
   address (?days=). *@
<partial name="_AdminBar" model="Model" />
<style>
    .brochure-page .stats-ranges { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0 0 var(--space-5); padding: 0; list-style: none; }
    .stats-totals { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--space-3); margin: 0 0 var(--space-6); }
    .stats-totals .card { margin: 0; }
    .stats-number { display: block; font-size: var(--text-3xl); font-weight: 700; line-height: 1.2; }
    .stats-label { font-size: var(--text-sm); color: var(--text-muted); }
    .stats-days { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(2px, 1fr); align-items: end; gap: 1px; height: 120px;
        padding: var(--space-2); border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); margin-bottom: var(--space-2); }
    .stats-day { display: flex; flex-direction: column-reverse; min-height: 1px; }
    .stats-day span { display: block; }
    .stats-ai { background: var(--accent); }
    .stats-search { background: #a9c7d0; }
    .stats-key { display: flex; gap: var(--space-4); font-size: var(--text-sm); color: var(--text-muted); margin-bottom: var(--space-6); }
    .stats-key i { display: inline-block; width: 12px; height: 12px; margin-right: var(--space-1); border-radius: 2px; vertical-align: -1px; }
    .stats-table { width: 100%; border-collapse: collapse; font-size: var(--text-base); margin-bottom: var(--space-6); }
    .stats-table th, .stats-table td { text-align: left; padding: var(--space-2) var(--space-3) var(--space-2) 0; border-bottom: 1px solid var(--surface-alt); vertical-align: top; }
    .stats-table th { font-size: var(--text-sm); color: var(--text-muted); font-weight: 600; }
    .stats-table td.num, .stats-table th.num { text-align: right; font-variant-numeric: tabular-nums; }
    .stats-path { font-family: var(--mono); font-size: var(--text-sm); overflow-wrap: anywhere; }
</style>
<h1>Visits</h1>
<p>
    The site counts the automated readers it can recognise: AI services and search engines, each by the name its company publishes.
    It records only the reader’s name, the page and the day, never anything about a person.
    @if (Model.AnalyticsUrl is not null)
    {
        <text>Visits by people are counted by <a href="@Model.AnalyticsUrl" rel="noopener">the site’s analytics</a>.</text>
    }
    New visits appear here within a minute.
</p>
<nav aria-label="Period">
    <ul class="stats-ranges">
        @foreach (var d in ParksComputing.Engine.Pages.SiteAdmin.StatsModel.Ranges)
        {
            <li><a class="btn btn-sm@(d == Model.Days ? " btn-primary" : "")" href="/admin/stats?days=@d" aria-current="@(d == Model.Days ? "page" : null)">Last @(d == 365 ? "year" : d + " days")</a></li>
        }
    </ul>
</nav>

<div class="stats-totals">
    <div class="card"><span class="stats-number">@Model.AiTotal</span><span class="stats-label">visits by AI services</span></div>
    <div class="card"><span class="stats-number">@Model.SearchTotal</span><span class="stats-label">visits by search engines</span></div>
    <div class="card"><span class="stats-number">@Model.ForAi</span><span class="stats-label">reads of llms.txt or a page’s Markdown</span></div>
    <div class="card"><span class="stats-number">@Model.NotFound</span><span class="stats-label">requests for pages that don’t exist</span></div>
</div>

<h2>Day by day</h2>
<div class="stats-days" role="img" aria-label="Visits each day over the last @Model.Days days, AI and search engines">
    @foreach (var d in Model.DaysRead)
    {
        var ai = d.Ai * 100.0 / Model.MaxDay; var se = d.Search * 100.0 / Model.MaxDay;
        <div class="stats-day" style="height:@((ai + se).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%" title="@d.Day.ToString("d MMM yyyy"): @d.Ai AI, @d.Search search">
            @if (d.Ai > 0) { <span class="stats-ai" style="flex:@d.Ai"></span> }
            @if (d.Search > 0) { <span class="stats-search" style="flex:@d.Search"></span> }
        </div>
    }
</div>
<p class="stats-key"><span><i class="stats-ai"></i>AI services</span><span><i class="stats-search"></i>Search engines</span><span>@Model.DaysRead.First().Day.ToString("d MMM") to @Model.DaysRead.Last().Day.ToString("d MMM yyyy") (UTC days)</span></p>

<h2>By reader</h2>
@if (Model.Agents.Count == 0)
{
    <p>No automated readers in this period yet.</p>
}
else
{
    <table class="stats-table">
        <thead><tr><th scope="col">Reader</th><th scope="col">Kind</th><th scope="col" class="num">Visits</th><th scope="col" class="num">Pages</th><th scope="col">Last seen</th></tr></thead>
        <tbody>
            @foreach (var a in Model.Agents)
            {
                <tr><td>@a.Agent</td><td>@(a.Kind == "AI" ? "AI" : "Search")</td><td class="num">@a.Count</td><td class="num">@a.Pages</td><td>@a.Last.ToString("d MMM yyyy")</td></tr>
            }
        </tbody>
    </table>
}

<h2>By page</h2>
@if (Model.PagesRead.Count == 0)
{
    <p>No pages read by automated readers in this period yet.</p>
}
else
{
    <table class="stats-table">
        <thead><tr><th scope="col">Page</th><th scope="col" class="num">AI</th><th scope="col" class="num">Search</th><th scope="col">Most often</th></tr></thead>
        <tbody>
            @foreach (var p in Model.PagesRead)
            {
                <tr><td class="stats-path">@p.Path</td><td class="num">@p.Ai</td><td class="num">@p.Search</td><td>@p.Top</td></tr>
            }
        </tbody>
    </table>
}
