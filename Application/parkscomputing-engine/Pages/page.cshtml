@page "/{section}/{**slug}"
@model ParksComputing.Engine.Pages.PageLoaderModel
@inject Microsoft.Extensions.Options.IOptions<ParksComputing.Engine.Identity.AdminOptions> AdminConfig
@{
    Layout = "_Layout";
    ViewData["Title"] = Html.Raw(Model.Title);
}

@section Meta {
    @if (Model.MetaElements is not null)
    {
        @foreach (var element in @Model.MetaElements)
        {
            @Html.Raw(element.OuterHtml)
            @Html.Raw("\n")
        }
    }
}

@section Links {
    @if (Model.LinkElements is not null)
    {
        @foreach (var element in @Model.LinkElements)
        {
            @Html.Raw(element.OuterHtml)
            @Html.Raw("\n")
        }
    }
}

@section Style {
    @if (Model.StyleElements is not null)
    {
        @foreach (var element in @Model.StyleElements)
        {
            @Html.Raw(element.OuterHtml)
            @Html.Raw("\n")
        }
    }
}

@section HeadScripts {
    @if (Model.HeadScriptElements is not null)
    {
        @foreach (var element in @Model.HeadScriptElements)
        {
            @Html.Raw(element.OuterHtml)
            @Html.Raw("\n")
        }
    }
}

@{
    bool hasInnerH1 = Model.PageContent?.IndexOf("<h1", System.StringComparison.OrdinalIgnoreCase) >= 0;
    // An applet page (marked by its own <meta name="applet-page">) is the
    // app itself: no tag row, no dates. An article that merely embeds an
    // applet keeps both.
    bool isApplet = Model.MetaElements?.Any(m => m.OuterHtml.Contains("applet-page", System.StringComparison.OrdinalIgnoreCase)) ?? false;
}
@{
    // A page framed in a window (?frame) leaves its tags to the window,
    // whose row opens a menu in the window view.
    bool framed = ViewContext.HttpContext.Request.Query.ContainsKey("frame");
    var pageTags = isApplet || framed ? null : Model.NavService.GetNavNode(ViewData["PageId"]?.ToString() ?? string.Empty)?.Tags;
}
@if (pageTags is { Length: > 0 })
{
    @* The tag row: each link leads to the tag's classic page, staying in
       the classic view. *@
    <nav class="page-tags" aria-label="Tags">
        @foreach (var tag in pageTags)
        {
            <a class="tag-link" href="@ParksComputing.Engine.Pages.Services.ArticleContentService.TagPageUrl(tag)">@tag</a>
        }
    </nav>
}
@{
    // A book's page sits inside the book: its contents beside it, and the
    // previous and next chapters below (Pages/Services/BookService.cs).
    var book = ViewData["Book"] as ParksComputing.Engine.Pages.Services.BookService.Book;
    var bookChapter = ViewData["BookChapter"] as string ?? string.Empty;
}
@if (book is not null)
{
    @Html.Raw(ParksComputing.Engine.Pages.Services.BookService.RenderOpen(book, bookChapter))
}
<article class="post-content">
    <header class="post-header">
        @if (!hasInnerH1)
        {
            <h1 class="post-title">@Html.Raw(Model.Title)</h1>
        }
        @if (!isApplet)
        {
            <div class="post-meta">
                <time datetime="@Model.CreatedGmt">@Model.Created</time>
                @if (Model.CreatedGmt != Model.ModifiedGmt)
                {
                    <span class="updated-on">&nbsp;· Updated <time datetime="@Model.ModifiedGmt">@Model.Modified</time></span>
                }
                @* The page's source on the edit origin, which asks for sign-in
                   (Architecture/admin-and-identity-design.md). Not in a preview. *@
                @if (!framed && ViewData["PageId"] is string editSlug)
                {
                    <a class="post-edit" href="@(AdminConfig.Value.EditOrigin.TrimEnd('/'))/admin/source?slug=@Uri.EscapeDataString(editSlug)" rel="nofollow">Edit</a>
                }
            </div>
        }

        @{
            bool hasAudio = ViewData["HasAudio"] as bool? ?? false;
            string? audioFilePath = ViewData["AudioFilePath"] as string;
            bool hasTranscript = ViewData["HasTranscript"] as bool? ?? false;
        }
        @if (hasAudio && !string.IsNullOrEmpty(audioFilePath))
        {
            <details class="media-accordion" id="audio-content">
                <summary>Listen to this article</summary>
                <div class="media-accordion-body">
                    <div class="audio-player-container" role="complementary" aria-label="Audio version of article">
                        <div id="main-audio-player" data-audio-player="true" data-audio-file="@audioFilePath"
                             data-transcript="@(hasTranscript ? "true" : "false")"></div>
                        <div class="audio-download">
                            <a href="@audioFilePath" download class="audio-download-link">
                                Download audio file
                            </a>
                        </div>
                    </div>
                </div>
            </details>
        }

        @{
            bool hasVideo = ViewData["HasVideo"] as bool? ?? false;
            var videoInfo = ViewData["VideoInfo"] as ParksComputing.Engine.Api.VideoInfo;
        }
        @if (hasVideo && videoInfo != null)
        {
            <details class="media-accordion" id="video-content">
                <summary>Watch video commentary</summary>
                <div class="media-accordion-body">
                    <div class="video-player-container" role="complementary" aria-label="Video commentary for article">
                        @if (videoInfo.Platform == "YouTube")
                        {
                            <div class="youtube-embed">
                                <iframe src="@videoInfo.EmbedUrl" title="Video commentary for @Model.Title" frameborder="0"
                                        allowfullscreen loading="lazy" width="560" height="315">
                                </iframe>
                            </div>
                        }
                        else
                        {
                            <div class="generic-video-embed">
                                <a href="@videoInfo.OriginalUrl" target="_blank" rel="noopener noreferrer">
                                    Watch Video Commentary (@videoInfo.Platform)
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </details>
        }
    </header>
    <div class="post-body">
        @* Every article has a front menu in PUDL's menu bar: what its author
           declared (PageMenu, or an HTML article's own nav), or else an
           empty one, which still gives the menu PUDL's first title of the
           article's name, with Copy the link and Print. *@
        @if (Model.PageContent?.Contains("data-page-menu", System.StringComparison.Ordinal) != true)
        {
            <nav data-page-menu hidden aria-label="Page menu"><ul></ul></nav>
        }
        @Html.Raw(Model.PageContent)
    </div>
</article>
@if (book is not null)
{
    @Html.Raw(ParksComputing.Engine.Pages.Services.BookService.RenderClose(book, bookChapter))
}