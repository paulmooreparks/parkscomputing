@model ParksComputing.Engine.Pages.Services.NavNode
@if (Model?.Nav != null)
{
    var sections = Model.Nav.Where(n => n?.Nav is { Length: > 0 }).ToArray();
    var currentCat = ViewData["NavCat"] as string;
    var onHome = ViewData["NavHome"] as bool? ?? false;

    @* The classic view's categories as tabs in the top bar (PUDL 0.37.0),
       between the logo menu and the view switcher: the tab for the category
       shown stands flat and opens into the page, so it reads as one choice
       among several. Every section, Articles among them, in sitenav.xfer's
       order. On a phone PUDL gives the tabs the top bar's last row, where
       they scroll sideways. *@
    <nav class="topbar-tabs" aria-label="Categories">
        <a aria-current="@(onHome && currentCat is null ? "page" : null)" href="/home">All</a>
        @foreach (var link in sections)
        {
            <a aria-current="@(currentCat == link!.Slug ? "page" : null)"
               href="/home?cat=@link.Slug" title='@(link.Description ?? link.Title)'>@link.Title</a>
        }
    </nav>
}
