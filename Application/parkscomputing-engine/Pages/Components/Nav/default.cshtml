@model ParksComputing.Engine.Pages.Services.NavNode
@if (Model != null)
{
    <a class="section-tab" href='@Model.Url' title='@(Model.Description ?? Model.Title)'>@Model.Title</a>

    @if (Model.Nav != null)
    {
        var lastDropdownIndex = System.Array.FindLastIndex(Model.Nav, n => n?.Nav != null && n.Nav.Length > 0);
        for (int i = 0; i < Model.Nav.Length; i++)
        {
            var link = Model.Nav[i];
            var linkTip = link?.Description ?? link?.Excerpt ?? link?.Title ?? string.Empty;
            if (link?.Nav != null && link.Nav.Length > 0)
            {
                // The final dropdown opens leftward so it cannot overflow the viewport.
                var dropClasses = (i == lastDropdownIndex) ? "nav-drop nav-drop-end" : "nav-drop";
                <details class='@dropClasses'>
                    <summary class="section-tab" title='@linkTip'>@link.Title</summary>
                    <div class="nav-menu">
                        @foreach (var sublink in link.Nav)
                        {
                            if (sublink != null)
                            {
                                <a href='@sublink.Url' title='@(sublink.Description ?? sublink.Excerpt ?? sublink.Title)'
                                   @if (!string.IsNullOrEmpty(sublink.Target)) {<text>target='@sublink.Target'</text>}>@sublink.Title</a>
                            }
                        }
                    </div>
                </details>
            }
            else
            {
                <a class="section-tab" href='@link?.Url' title='@linkTip'>@link?.Title</a>
            }
        }
    }
}
