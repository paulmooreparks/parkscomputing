@model ParksComputing.Engine.Pages.Services.NavNode
@if (Model != null)
{
    <a class="section-tab" href='@Model.Url' title='@(Model.Description ?? Model.Title)'>@Model.Title</a>

    @if (Model.Nav != null)
    {
        var sections = Model.Nav.Where(n => n?.Nav is { Length: > 0 }).ToArray();
        var leaves = Model.Nav.Where(n => n is not null && (n.Nav is null || n.Nav.Length == 0)).ToArray();
        var lastDropdownIndex = sections.Length - 1;

        for (int i = 0; i < sections.Length; i++)
        {
            var link = sections[i];
            var linkTip = link?.Description ?? link?.Excerpt ?? link?.Title ?? string.Empty;
            // The final dropdown opens leftward so it cannot overflow the viewport.
            var dropClasses = (i == lastDropdownIndex) ? "nav-drop nav-drop-end" : "nav-drop";
            <details class='@dropClasses'>
                <summary class="section-tab" title='@linkTip'>@link!.Title</summary>
                <div class="nav-menu">
                    @foreach (var sublink in link.Nav!)
                    {
                        if (sublink != null)
                        {
                            <a href='@sublink.Url' title='@(sublink.Description ?? sublink.Excerpt ?? sublink.Title)'
                               @if (!string.IsNullOrEmpty(sublink.Target)) {<text>target='@sublink.Target'</text>}>@sublink.Title</a>
                        }
                    }
                </div>
            </details>
        }

        @* Bare links (no children) are not sections: they live in their own
           area on the right, behind a partial-height separator, matching
           the window view's bar. *@
        if (leaves.Length > 0)
        {
            <span class="bar-spacer"></span>
            <span class="bar-sep" aria-hidden="true"></span>
            <div class="bar-links">
                @foreach (var leaf in leaves)
                {
                    var leafTip = leaf!.Description ?? leaf.Excerpt ?? leaf.Title ?? string.Empty;
                    <a class="section-tab" href='@leaf.Url' title='@leafTip'
                       @if (!string.IsNullOrEmpty(leaf.Target)) {<text>target='@leaf.Target'</text>}>@leaf.Title</a>
                }
            </div>
        }
    }
}
