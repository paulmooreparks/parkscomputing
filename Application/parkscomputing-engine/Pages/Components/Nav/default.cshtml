@model ParksComputing.Engine.Pages.Services.NavNode
@if (Model?.Nav != null)
{
    var sections = Model.Nav.Where(n => n?.Nav is { Length: > 0 }).ToArray();
    var currentCat = ViewData["NavCat"] as string;
    var onHome = ViewData["NavHome"] as bool? ?? false;

    @* The same grammar as the window view: category tabs filter the home
       page's cards, and the brand wordmark is the way home. *@
    <a class="section-tab" aria-current="@(onHome && currentCat is null ? "true" : null)" href="/home">All</a>
    @* Every section, Articles among them, in sitenav.xfer's order. *@
    @foreach (var link in sections)
    {
        <a class="section-tab" aria-current="@(currentCat == link!.Slug ? "true" : null)"
           href="/home?cat=@link.Slug" title='@(link.Description ?? link.Title)'>@link.Title</a>
    }

    @* Bare links (no children), such as About, are in the site menu, which
       sitenav.xfer's menu array fills, in both views. *@
}
