@model ParksComputing.Engine.Pages.Services.NavNode
@if (Model?.Nav != null)
{
    var sections = Model.Nav.Where(n => n?.Nav is { Length: > 0 }).ToArray();
    var currentCat = ViewData["NavCat"] as string;
    var onHome = ViewData["NavHome"] as bool? ?? false;
    var current = sections.FirstOrDefault(s => s!.Slug == currentCat);
    // What the phone's drop-down says: the category shown, All on the home
    // page with none chosen, and elsewhere just what it opens.
    var label = current?.Title ?? (onHome ? "All" : "Categories");

    @* The classic view's categories, in the top bar between the logo menu
       and the view switcher (Paul, 2026-10-01): PUDL's topbar pills, links
       to /home?cat=, the one shown pressed in with aria-current. Every
       section, Articles among them, in sitenav.xfer's order. On a phone the
       pills give way to one drop-down holding the same links, whose label
       shortens with an ellipsis before anything else in the bar does. *@
    <nav class="site-cats" aria-label="Categories">
        <a class="topbar-pill" aria-current="@(onHome && currentCat is null ? "true" : null)" href="/home">All</a>
        @foreach (var link in sections)
        {
            <a class="topbar-pill" aria-current="@(currentCat == link!.Slug ? "true" : null)"
               href="/home?cat=@link.Slug" title='@(link.Description ?? link.Title)'>@link.Title</a>
        }
    </nav>
    <div class="menu site-cats-menu">
        <button type="button" class="topbar-pill menu-btn" popovertarget="site-cats-menu"><span class="menu-btn-label">@label</span></button>
        <nav class="menu-panel" id="site-cats-menu" popover aria-label="Categories">
            <div class="md-row"><a class="md-item" href="/home" aria-current="@(onHome && currentCat is null ? "true" : null)">All</a></div>
            @foreach (var link in sections)
            {
                <div class="md-row"><a class="md-item" href="/home?cat=@link!.Slug" aria-current="@(currentCat == link.Slug ? "true" : null)">@link.Title</a></div>
            }
        </nav>
    </div>
}
