@page
@model ParksComputing.Engine.Pages.Admin.DesktopModel
@using ParksComputing.Engine.Pages.Models
@{
    ViewData["Title"] = "Desktop";
    ViewData["Workspace"] = true;
    ViewData["Desktop"] = true;

    // The tools, as windows made from the templates below. A numbered
    // terminal (terminal-2) is PUDL's copy of the terminal's template.
    var tools = new[] {
        new WindowViewModel { Key = "terminal", Title = "Terminal", PageUrl = "/admin/terminal", Mode = "maximized",
            BodyHtml = "<div data-applet=\"terminal\" role=\"application\" aria-label=\"Terminal\"></div>" },
        new WindowViewModel { Key = "editor", Title = "Editor", PageUrl = "/admin/editor", Mode = "maximized",
            BodyHtml = "<div data-applet=\"editor\" role=\"application\" aria-label=\"Editor\"></div>" },
        new WindowViewModel { Key = "files", Title = "Files", PageUrl = "/admin/files", Mode = "maximized",
            BodyHtml = "<div data-applet=\"files\" role=\"application\" aria-label=\"Files\"></div>" }
    };
    var taskbar = new TaskbarModel {
        Entries = new[] {
            new TaskbarEntry("New terminal", "/admin/terminal", "script", Request: "shell"),
            new TaskbarEntry("Editor", "/admin/editor", "document", Window: "editor"),
            new TaskbarEntry("Files", "/admin/files", "folder", Window: "files")
        }
    };
}
@* The admin desktop (Architecture/admin-and-identity-design.md, A12): the
   file tree at the side, the tools as PUDL windows, and the taskbar along
   the bottom. PUDL's master-detail layout shows the tree or the windows
   one at a time on a narrow screen. js/admin-desktop.js fills the tree. *@
<div class="md-layout admin-desk" data-md-pane="list">
    <div class="md-body">
        <nav class="md-sidebar admin-tree" aria-label="Files" data-desk-tree>
            <p class="admin-tree-note" data-desk-tree-note>Loading the files…</p>
        </nav>
        <div class="md-resize" role="separator" aria-orientation="vertical" aria-label="Resize the files"></div>
        <div class="md-detail admin-stage">
            <a class="md-back" href="?open=" data-win-back>Files</a>
            <main class="win-host">
                <div class="admin-empty">
                    <p>Open a tool from <strong>Start</strong>, or a file from the tree.</p>
                    <p>Right-click a file or folder, or press Shift+F10 on it, for more.</p>
                </div>
                <div class="win-layer" data-win-layer data-win-src="#win-{key}"></div>
            </main>
        </div>
    </div>
</div>
@foreach (var tool in tools)
{
    <template id="win-@tool.Key"><partial name="_Window" model="tool" /></template>
}
<partial name="_Taskbar" model="taskbar" />
