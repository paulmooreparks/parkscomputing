@page "/admin/articles"
@model ParksComputing.Engine.Pages.Admin.Articles.IndexModel
@{ ViewData["Title"] = "Article workspace"; }
<div class="account-page account-page-wide">
<h1>Article workspace</h1><p>This workspace keeps drafts and published revisions in the site's database, apart from the site's own articles, which are files under /wwwroot that you edit in the Editor. Articles made here appear only at their own addresses.</p>
@if (!Model.Confirmed) {
    <p>Confirm with a passkey to edit articles.</p><button class="btn btn-primary" type="button" data-passkey="confirm">Confirm with a passkey</button><p class="form-error" data-passkey-status role="status" hidden></p>
} else {
    <p><a class="btn btn-primary" href="/admin/articles/edit">Create article</a></p>
    @if (Model.Articles.Count == 0) { <p>No articles have been created yet.</p> }
    <ul>@foreach (var article in Model.Articles) { <li><a href="/admin/articles/edit/@article.Id">@article.Title</a> <small>@article.Slug, draft @article.Draft, @(article.Published is null ? "unpublished" : "published revision " + article.Published)</small></li> }</ul>
}
</div>
