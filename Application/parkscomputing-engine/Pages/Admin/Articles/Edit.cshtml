@page "/admin/articles/edit/{id:guid?}"
@model ParksComputing.Engine.Pages.Admin.Articles.EditModel
@{ ViewData["Title"] = Model.Id is null ? "Create article" : "Edit article"; }
<div class="account-page account-page-wide">
<p><a href="/admin/articles">All articles</a></p><h1>@ViewData["Title"]</h1>
<form method="post" asp-page-handler="Save" class="stack">
    <div class="form-error" asp-validation-summary="All" role="alert"></div>
    <input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><input asp-for="Operation" type="hidden" />
    @if (Model.Id is null) { <div class="form-group"><label class="form-label" asp-for="Slug">Article path</label><input class="form-input" asp-for="Slug" maxlength="400" required /></div> }
    else { <input asp-for="Slug" type="hidden" /><p>@Model.Slug, draft revision @Model.Revision</p> }
    <div class="form-group"><label class="form-label" asp-for="ArticleTitle">Title</label><input class="form-input" asp-for="ArticleTitle" maxlength="300" required /></div>
    <div class="form-group"><label class="form-label" asp-for="Format">Source format</label><select class="form-input" asp-for="Format" asp-items="Html.GetEnumSelectList<ParksComputing.Engine.Publishing.ArticleFormat>()"></select></div>
    <div class="form-group"><label class="form-label" asp-for="Source">Source</label><textarea class="form-input" asp-for="Source" rows="20" spellcheck="false"></textarea></div>
    <input asp-for="Comments" type="hidden" /><button class="btn btn-primary">Save draft</button>
</form>
@if (Model.Id is not null) {
    <section><h2>Publication</h2><p>@(Model.Published is null ? "This article is unpublished." : "Revision " + Model.Published + " is published.")</p>
    <p>Save your changes before previewing or publishing. These actions use the saved draft.</p>
    <p><a class="btn" href="/admin/articles/preview/@Model.Id?revision=@Model.Revision">Preview saved draft</a> <a href="/admin/articles/edit/@Model.Id">Reload latest draft</a></p>
    <form method="post" asp-page-handler="Publish">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><input asp-for="Operation" type="hidden" /><input asp-for="Revision" type="hidden" /><button class="btn">Publish saved draft</button></form>
    @if (Model.Published is not null) {
        <p><a href="/articles/@Model.Id">View published article</a></p>
        <form method="post" asp-page-handler="Unpublish">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><input asp-for="Operation" type="hidden" /><button class="btn btn-danger">Unpublish</button></form>
    }
    </section>
}
</div>
