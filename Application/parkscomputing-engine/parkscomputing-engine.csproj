<Project Sdk="Microsoft.NET.Sdk.Web">

	 <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		 <TypeScriptTarget>ES2021</TypeScriptTarget>
	 </PropertyGroup>

	 <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		 <TypeScriptTarget>ES2021</TypeScriptTarget>
	 </PropertyGroup>

	 <PropertyGroup>
			<TargetFramework>net8.0</TargetFramework>
			<AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
			<AssemblyName>ParksComputing.Engine</AssemblyName>
			<RootNamespace>ParksComputing.Engine</RootNamespace>
			<Nullable>enable</Nullable>
			<GenerateDocumentationFile>true</GenerateDocumentationFile>
			<NoWarn>$(NoWarn);1591</NoWarn>
			<!-- Re-disabled due to duplicate static web asset key build failure (android-chrome-192x192.png). -->
			<EnableDefaultStaticWebAssetsCompression>false</EnableDefaultStaticWebAssetsCompression>
			<StaticWebAssetEnableCompression>false</StaticWebAssetEnableCompression>
			<!-- Completely disable static web assets pipeline (serving will be manual / dynamic). -->
			<DisableImplicitStaticWebAssets>true</DisableImplicitStaticWebAssets>
			<!-- Additional hard disable to prevent DefineStaticWebAssets from running -->
			<StaticWebAssetProjectMode>Disable</StaticWebAssetProjectMode>
			<GenerateStaticWebAssetsPropsFile>false</GenerateStaticWebAssetsPropsFile>
			<GenerateStaticWebAssetsManifest>false</GenerateStaticWebAssetsManifest>
			<UseStaticWebAssets>false</UseStaticWebAssets>
			<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
	 </PropertyGroup>

	 <ItemGroup>
			<PackageReference Include="BuildBundlerMinifier" Version="3.2.449" />
			<PackageReference Include="HtmlAgilityPack" Version="1.11.60" />
			<PackageReference Include="LibSassBuilder" Version="3.0.0" />
			<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="9.0.0" />
			<PackageReference Include="ParksComputing.Xfer.Lang" Version="0.15.25-prerelease" />
			<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
			<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="6.5.0" />
			<PackageReference Include="Markdig" Version="0.37.0" />
			<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
			<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.6.0" />
			<!-- Auth storage packages -->
			<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
			<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
			<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8" PrivateAssets="All" />
			<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
			<!-- TODO: Add real version once package is published -->
			<!-- <PackageReference Include="ParksComputing.Xfer.Lang" Version="0.1.0-preview" /> -->
	 </ItemGroup>

	<!-- Exclude IDE / build artifacts accidentally under wwwroot that cause large deployments & duplicate static web asset keys -->
	<ItemGroup>
		<Content Remove="wwwroot\\**\\.vs\\**" />
		<Content Remove="wwwroot\\content\\**\\.vs\\**" />
		<Content Remove="wwwroot\\content\\**\\*.ipch" />
		<Content Remove="wwwroot\\content\\**\\*.vc.db" />
		<Content Remove="wwwroot\\content\\**\\Browse.VC.db" />
		<Content Remove="wwwroot\\content\\**\\*.vsidx" />
		<Content Remove="wwwroot\\content\\**\\slnx.sqlite" />
		<Content Remove="wwwroot\\content\\**\\*.sqlite" />
	</ItemGroup>


	 <ItemGroup>
		 <Folder Include="wwwroot\src\" />
	 </ItemGroup>

	 <!-- Removed SmartSamComments project references temporarily -->

	<!-- Bypass duplicate static asset key failure by overriding the DiscoverPrecompressedAssets target (no-op). -->
	<Target Name="DiscoverPrecompressedAssets" />
	<!-- Hard override of DefineStaticWebAssets target to no-op to bypass hashing collision during incremental builds. -->
	<Target Name="DefineStaticWebAssets" Returns="@(StaticWebAsset)">
		<Message Text="DefineStaticWebAssets disabled" Importance="low" />
	</Target>

</Project>
